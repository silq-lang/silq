// args: --run

def g(const v:𝔹^2)qfree:𝔹⇒dup(v[1]);
def chain(){
	c:=H(1:𝔹); q:=H(0:𝔹);
	w:=vector(2,vector(2,0:𝔹)); w[0][0]⊕=c; w[0][1]⊕=c; w[1][1]⊕=c;
	r:=c⊕w[q][1];
	forget(r=0:𝔹);
	w[0][0]⊕=c; w[0][1]⊕=c; w[1][1]⊕=c;
	forget(w=vector(2,vector(2,0:𝔹)));
	return (measure(H(c)),measure(H(q)));
}
def slice(){
	c:=H(1:𝔹); q:=H(0:𝔹);
	w:=vector(2,vector(3,0:𝔹)); w[0][0]⊕=c; w[0][1]⊕=c; w[1][1]⊕=c; w[1][2]⊕=q;
	r:=c⊕g(w[q][0..2]);
	forget(r=0:𝔹);
	w[0][0]⊕=c; w[0][1]⊕=c; w[1][1]⊕=c; w[1][2]⊕=q;
	forget(w=vector(2,vector(3,0:𝔹)));
	return (measure(H(c)),measure(H(q)));
}
def run()⇒(chain(),slice());
def main(){
	for i in 0..8 { assert(run()==((1,0),(1,0))); }
	r:=run();
	assert(r==((1,0),(1,0)));
	return r;
}
