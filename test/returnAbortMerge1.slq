def f(x:𝔹){
	if (0:𝔹) { return x; } else { if (0:𝔹) { assert(false); } return x; } /// run_error
}
def g(x:𝔹){
	if (1:𝔹) { if (1:𝔹) { assert(false); } return x; } else { return x; }
}
def h(x:𝔹,y:!𝔹){
	if (0:𝔹) { return (x,y); } else { if (0:𝔹) { assert(false); } return (x,y); }
}
def k(x:𝔹,c:!𝔹){
	if (0:𝔹) {
		if c { return x; }
		return x;
	} else {
		if (0:𝔹) { assert(false); }
		return x;
	}
}
def main(){
	return (f(H(0:𝔹)),g(H(0:𝔹)),h(H(0:𝔹),true),k(H(0:𝔹),false));
