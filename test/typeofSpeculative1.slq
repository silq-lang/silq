// args: --run

def f(){
	x:=H(0:𝔹);
	o:=dup(x);
	if measure(H(0:𝔹)){ y:=0:typeof(measure(o)); }
	return x;
}
def g(){
	x:=H(0:𝔹);
	q:=dup(x);
	if measure(H(0:𝔹)){ forget(q); y:=0:typeof(measure(x)); }
	return x;
}
def h(){
	x:=H(0:𝔹);
	q:=dup(x);
	y:=0:typeof(dup(q));
	return x;
}
def k(){
	x:=H(0:𝔹);
	o:=dup(x);
	c:=measure(H(0:𝔹));
	y:=0:typeof(if c { measure(o) } else { measure(dup(o)) });
	w:=0:typeof(if c { measure(o) } else { measure(o) });
	a:=(H(0:𝔹),H(0:𝔹));
	p:=dup(a);
	z:=0:typeof(measure(p[0]));
	return (x,a);
}
def l(n:!ℕ){
	x:=H(0:𝔹);
	for i in 0..n {
		o:=dup(x);
		y:=0:typeof(measure(o));
		x:=H(x);
	}
	return x;
}
def main()⇒(f(),g(),h(),k(),l(2));
