// args: --run

def main(){
	x:=1;
	z:=2;
	def baz(x:!ℕ){
		forget(x);
		return x;
	}
	def qux(x:!ℕ,z:!ℕ){
		forget((x,z));
		return x+z;
	}
	def quux(x:!ℕ){
		for i in [0..2){ x+=i; }
		if x=6 { forget(x); } else { forget(x); }
		return x;
	}
	f:=λ(x:!ℕ){ forget(x); return x; };
	r:=(baz(5),qux(5,6),quux(5),f(5));
	assert(r=(1,3,1,1));
	return r;
}
