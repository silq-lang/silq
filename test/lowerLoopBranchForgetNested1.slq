// args: --remove-loops --run

def f(c:!ℕ,const a:𝔹,n:!ℕ){
	x:=dup(a) as uint[4]; b:=dup(a);
	repeat n {
		if c%3==0 {
			t:=0:uint[2];
			t[0]⊕=x[0];
			if t==1 { b:=X(b); }
			forget(t);
		}
		x+=1;
	}
	return (x,b);
}
def g(c:!ℕ,const a:𝔹,n:!ℕ){
	x:=dup(a) as uint[4]; b:=dup(a);
	k:=0:!ℕ;
	for i in [0..n){
		k+=i;
		if c%3==0 {
			t:=0:uint[2];
			t[0]⊕=x[0];
			if t==1 { b:=X(b); }
			forget(t);
		}
		x+=k;
	}
	forget(x);
	return (k,b);
}
def h(c:!ℕ,n:!ℕ,cs:!ℕ[]){
	x:=0:uint[4]; x[0]:=H(x[0]);
	b:=0:𝔹;
	repeat n {
		if c%3==0 {
			t:=0:uint[2];
			t[0]⊕=x[0];
			if t==1 { b:=X(b); }
		}
		for i in [0..cs.length) { x+=cs[i]; }
	}
	return (x,b);
}
def main(){
	(x,b):=f(0,1:𝔹,2);
	assert(measure(x,b)==(3,0));
	(k,b2):=g(0,1:𝔹,3);
	assert(k==3);
	assert(measure(b2)==1);
	a:=H(0:𝔹);
	(k3,b3):=g(0,a,3);
	(x4,b4):=h(0,2,[2]);
	assert(measure(b4)==0);
	return (a,b3,x4);
}
