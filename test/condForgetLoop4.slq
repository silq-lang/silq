// args: --remove-loops --run

def f(){
	x:=(H(0:𝔹),0:𝔹);
	b:=H(0:𝔹);
	repeat 2 {
		if x[0] {
			x[1]:=X(x[1]);
			(x[1],b):=(b,x[1]);
		}
	}
	return (x,b);
}
def g(){
	x:=(H(0:𝔹),0:𝔹,0:𝔹);
	repeat 2 {
		if x[0] {
			x[1]:=X(x[1]);
			x[2]⊕=x[1];
			x[1]:=X(x[1]);
		}
	}
	return x;
}
def main()⇒(f(),g());
