// args: --run

def f(){
	x:=H(0:𝔹);
	w:=H(0:𝔹);
	cp:=dup(w);
	p:=dup(cp);
	if measure(H(0:𝔹)) { m1:=measure(p); }
	if p { w:=X(w); }
	m2:=measure(p);
	return (x,w);
}
def g(){
	x:=H(0:𝔹);
	w:=H(0:𝔹);
	p:=dup(w);
	if measure(H(0:𝔹)) { m1:=measure(p); }
	if p { w:=X(w); }
