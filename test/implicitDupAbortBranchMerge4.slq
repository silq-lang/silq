// args: --run

def measuredBeforeConsumption(a:𝔹,k:!𝔹){
	ms:=0:!ℕ;
	v0:=dup(a);
	t2:=measure(v0);
	ms+=t2;
	if k {
		u3:=!v0; forget(u3);
		x5:=(a,ms);
		assert(false);
	}
	t8:=measure(v0);
	ms+=t8;
	a:=X(a);
	return (a,ms);
}
def nestedAbortingBranch(a:𝔹,k:!𝔹,l:!𝔹){
	ms:=0:!ℕ;
	v0:=dup(a);
	t2:=measure(v0);
	ms+=t2;
	if k {
		if l {
			u3:=!v0; forget(u3);
			x5:=(a,ms);
			assert(false);
		}
	}
	t8:=measure(v0);
	ms+=t8;
	a:=X(a);
	return (a,ms);
}
def main(){
	r:=(measure(measuredBeforeConsumption(1:𝔹,false)),measure(nestedAbortingBranch(1:𝔹,true,false)),measure(nestedAbortingBranch(0:𝔹,false,true)));
	assert(r==((0,2),(0,2),(1,0)));
	return r;
}
