// args: --run

def make(a:!ℕ,b:!ℕ):⋃[n:!ℕ,m:!ℕ]. !ℕ^(n·m+1)⇒vector(a·b+1,3:!ℕ);
def pass(x:⋃[n:!ℕ,m:!ℕ]. !ℕ^(n·m+1)):⋃[n:!ℕ,m:!ℕ]. !ℕ^(n·m+1)⇒x;
def nested(a:!ℕ,b:!ℕ):⋃[n:!ℕ][m:!ℕ]. 𝔹^(n·m+2)⇒vector(a·b+2,0:𝔹);
def passNested(x:⋃[n:!ℕ][m:!ℕ]. 𝔹^(n·m+2)):⋃[n:!ℕ][m:!ℕ]. 𝔹^(n·m+2)⇒x;
def main(){
	r:=(pass(make(0,3)):!ℕ[],pass(make(2,1)):!ℕ[],measure(passNested(nested(0,1)):𝔹[]));
	assert(r==((3,),(3,3,3),(0,0)));
	return r;
}
