// args: --run

def f(const c:!𝔹,x:𝔹^2){
	k:=0;
	do{ k+=1; measure(x); x:=vector(1,0:𝔹); }while k<1;
	if c { measure(x); }
	x:=vector(1,1:𝔹);
	return measure(x);
}
def g(const c:!𝔹,x:𝔹^2,n:!ℕ){
	k:=0;
	do{ k+=1; measure(x); x:=vector(n,0:𝔹); }while k<2;
	if c { measure(x); }
	x:=vector(n+1,1:𝔹);
	return measure(x:𝔹[]).length;
}
def h(const c:!𝔹){
	x:=vector(2,0:𝔹);
	for i in 0..1 {
		k:=0;
		do{ k+=1; measure(x); x:=vector(1,0:𝔹); }while k<1;
		if c { measure(x); }
		x:=vector(1,0:𝔹);
	}
	return measure(x:𝔹[]).length;
}
def main(){
	assert(f(true,vector(2,0:𝔹))==vector(1,1:!𝔹)&&f(false,vector(2,1:𝔹))==vector(1,1:!𝔹));
	assert(g(true,vector(2,0:𝔹),1)==2&&g(false,vector(2,1:𝔹),2)==3);
	assert(h(true)==1&&h(false)==1);
}
