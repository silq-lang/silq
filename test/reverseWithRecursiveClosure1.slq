// args: --run

def f(q:𝔹,xs:𝔹^2)mfree{
	with { def g(a:!ℕ):𝔹⇒if a==0 { dup(q) } else { (λ(b:!ℕ)⇒g(b))((a-1) coerce !ℕ) }; r:=g(1); } do { xs[0]:=X(xs[0]); }
	with { def h(a:!ℕ):𝔹⇒if a==0 { dup(q) } else { (λ(b:!ℕ)⇒(λ()⇒h(b))())((a-1) coerce !ℕ) }; r:=h(2); } do { xs[1]:=X(xs[1]); }
	return (q,xs);
}
def main(){
	(q,xs):=f(H(0:𝔹),vector(2,0:𝔹));
	assert(measure(H(q),xs)==(0,(1,1)));
}
