// args: --run

def f(k:!ℕ){
	x:=vector(4,0:!ℕ);
	x[0]=1; x[1]=2; x[2]=1; x[3]=1;
	(x[2],x[k]):=(x[k],x[2]);
	return x;
}

def g(k:!ℕ){
	x:=(1,2,1):!𝔹×!ℕ×!𝔹;
	(x[k],x[0]):=(x[0],x[k]);
	return x;
}

def h(const c:!𝔹,k:!ℕ){
	x:=vector(3,2:!ℕ);
	x[0]=1; x[2]=0;
	if c { (x[0],x[k]):=(x[k],x[0]); }
	return x;
}

def q(k:!ℕ){
	x:=(1:!𝔹,X(0:𝔹),0:!𝔹);
	(x[0],x[k]):=(x[k],x[0]);
	return measure(x);
}

def main(){
	assert(f(0)==(1,2,1,1)&&f(1)==(1,1,2,1));
	assert(g(1)==(2,1,1)&&g(2)==(1,2,1));
	assert(h(true,1)==(2,1,0)&&h(false,1)==(1,2,0));
	assert(q(1)==(1,1,0)&&q(2)==(0,1,1));
}
