	r:=(measure(updateBeforeBranch((1,0,1,0):𝔹^4,true,0)),measure(reverse(updateBeforeBranch)(updateBeforeBranch((1,0,1,0):𝔹^4,true,0),true,0)),measure(updateBeforeBranch((1,0,1,0):𝔹^4,false,1)),measure(reverse(updateBeforeBranch)(updateBeforeBranch((1,0,1,0):𝔹^4,false,1),false,1)),measure(quantumInBranch((1,0,1,0):𝔹^4,true,0)),measure(reverse(quantumInBranch)(quantumInBranch((1,0,1,0):𝔹^4,true,0),true,0)),measure(quantumInBranch((1,0,1,0):𝔹^4,false,1)),measure(reverse(quantumInBranch)(quantumInBranch((1,0,1,0):𝔹^4,false,1),false,1)),measure(updateInBranch((1,0,1,0):𝔹^4,true,0)),measure(reverse(updateInBranch)(updateInBranch((1,0,1,0):𝔹^4,true,0),true,0)),measure(updateInBranch((1,0,1,0):𝔹^4,false,1)),measure(reverse(updateInBranch)(updateInBranch((1,0,1,0):𝔹^4,false,1),false,1)),measure(updateInLoop((1,0,1,0):𝔹^4,true,1)),measure(reverse(updateInLoop)(updateInLoop((1,0,1,0):𝔹^4,true,1),true,1)),measure(updateInLoop((1,0,1,0):𝔹^4,false,0)),measure(reverse(updateInLoop)(updateInLoop((1,0,1,0):𝔹^4,false,0),false,0)),measure(updateInBranchInLoop((1,0,1,0):𝔹^4,true,1)),measure(reverse(updateInBranchInLoop)(updateInBranchInLoop((1,0,1,0):𝔹^4,true,1),true,1)),measure(updateInBranchInLoop((1,0,1,0):𝔹^4,false,0)),measure(reverse(updateInBranchInLoop)(updateInBranchInLoop((1,0,1,0):𝔹^4,false,0),false,0)),measure(updateAfterReadInLoop((1,0,1,0):𝔹^4,true,1)),measure(reverse(updateAfterReadInLoop)(updateAfterReadInLoop((1,0,1,0):𝔹^4,true,1),true,1)),measure(updateAfterReadInLoop((1,0,1,0):𝔹^4,false,2)),measure(reverse(updateAfterReadInLoop)(updateAfterReadInLoop((1,0,1,0):𝔹^4,false,2),false,2)),measure(readInNestedWith((1,0,1,0):𝔹^4,true,1)),measure(reverse(readInNestedWith)(readInNestedWith((1,0,1,0):𝔹^4,true,1),true,1)),measure(readInNestedWith((1,0,1,0):𝔹^4,false,2)),measure(reverse(readInNestedWith)(readInNestedWith((1,0,1,0):𝔹^4,false,2),false,2)),measure(redefinedInLoop((1,0,1,0):𝔹^4,true,0)),measure(reverse(redefinedInLoop)(redefinedInLoop((1,0,1,0):𝔹^4,true,0),true,0)),mea