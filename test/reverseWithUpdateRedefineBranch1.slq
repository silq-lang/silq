// args: --run

def updateBeforeBranch(xs:𝔹^4,const c:!𝔹,const j:!ℕ)mfree{
	v:=30;
	with { u:=2; } do {
		v+=j+2;
		xs[v%4]:=X(xs[v%4]);
		if c { forget(v); v:=1; }
	}
	return xs;
}

def quantumInBranch(xs:𝔹^4,const c:!𝔹,const j:!ℕ)mfree{
	v:=30;
	with { u:=2; } do {
		v+=j+2;
		xs[v%4]:=X(xs[v%4]);
		if c { forget(v); v:=1; xs[1]:=X(xs[1]); }
	}
	return xs;
}

def updateInBranch(xs:𝔹^4,const c:!𝔹,const j:!ℕ)mfree{
	v:=30;
	with { u:=2; } do {
		if c { v+=j+2; }
		xs[v%4]:=X(xs[v%4]);
		if c { forget(v); v:=1; }
	}
	return xs;
}

def updateInLoop(xs:𝔹^4,const c:!𝔹,const j:!ℕ)mfree{
	v:=30;
	with { u:=2; } do {
		for i in 0..3 {
			v+=j+2;
			xs[v%4]:=X(xs[v%4]);
		}
		if c { forget(v); v:=1; }
	}
	return xs;
}

def updateInBranchInLoop(xs:𝔹^4,const c:!𝔹,const j:!ℕ)mfree{
	v:=30;
	with { u:=2; } do {
		for i in 0..3 {
			if c { v+=j+2; }
			xs[v%4]:=X(xs[v%4]);
		}
		if c { forget(v); v:=1; }
	}
	return xs;
}

def updateAfterReadInLoop(xs:𝔹^4,const c:!𝔹,const j:!ℕ)mfree{
	v:=1;
	with { u:=3; } do {
		for i in 0..2 {
			xs[v%4]:=X(xs[v%4]);
			v+=j;
		}
		if c { forget(v); v:=2; }
	}
	return xs;
}

def readInNestedWith(xs:𝔹^4,const c:!𝔹,const j:!ℕ)mfree{
	v:=1;
	with { u:=3; } do {
		v+=j;
		with { s:=dup(v); } do { xs[s%4]:=X(xs[s%4]); }
		if c { forget(v); v:=2; }
	}
	return xs;
}

def redefinedInLoop(xs:𝔹^4,const c:!𝔹,const j:!ℕ)mfree{
	v:=30;
	w:=dup(v);
	if c {
		with { u:=2; } do {
			for i in 0..3 {
				if c { v+=j+2; }
				forget(w); w:=(j+j)%4;
				xs[v%4]:=X(xs[v%4]);
			}
			if c {
				for k in 0..1 {
					forget(v); v:=1;
					v+=w+w;
				}
			}
		}
	}
	return xs;
}

