	r:=(measure(nestedThenUsed(H(0:𝔹),true,true)),measure(H(nestedThenUsed(H(0:𝔹),true,false))),measure(nestedThenUsed(1:𝔹,false,true)),measure(nestedThenUsed(0:𝔹,false,false)),measure(nestedTwice(H(0:𝔹),true,true)),measure(H(nestedTwice(H(0:𝔹),true,false))),measure(nestedTwice(1:𝔹,false,false)),measure(bothNested(H(0:𝔹),true,true)),measure(H(bothNested(H(0:𝔹),true,false))),measure(bothNested(1:𝔹,false,true)),measure(H(bothNested(H(0:𝔹),false,false))),measure(copyUsedAfterMeasure(1:𝔹,true,false)),measure(H(copyUsedAfterMeasure(H(0:𝔹),false,true))),measure(copyUsedAfterMeasure(1:𝔹,false,false)),measure(copyForgotten(0:𝔹,true,true)),measure(H(copyForgotten(H(0:𝔹),false,true))),measure(copyForgotten(0:𝔹,false,false)),measure(copyOfParameter(0:𝔹,true,false)),measure(H(copyOfParameter(H(0:𝔹),false,true))),measure(H(copyOfParameter(H(0:𝔹),false,false))),measure(measuredAfterUpdate(1:𝔹,true,true)),measure(measuredAfterUpdate(0:𝔹,false,true)),measure(measuredAfterUpdate(1:𝔹,false,false)),measure(quantumInner(H(0:𝔹),true,1:𝔹)),measure(H(quantumInner(H(0:𝔹),true,0:𝔹))),measure(quantumInner(1:𝔹,false,1:𝔹)),measure(quantumInnerCopy(0:𝔹,true,0:𝔹)),measure(H(quantumInnerCopy(H(0:𝔹),false,1:𝔹))),measure(H(quantumInnerCopy(H(0:𝔹),false,0:𝔹))),measuredPair(siblingReturn(H(0:𝔹),H(0:𝔹),false,false,false,false),true),measuredPair(siblingReturn(H(0:𝔹),H(0:𝔹),true,true,false,true),true),measuredPair(siblingReturn(H(0:𝔹),H(0:𝔹),true,false,false,false),true),measuredPair(siblingReturn(0:𝔹,1:𝔹,true,true,true,false),false),measuredPair(siblingReturnMeasured(H(0:𝔹),H(0:𝔹),false,false,false),true),measuredPair(siblingReturnMeasured(0:𝔹,1:𝔹,true,true,false),false),measuredPair(siblingReturnMeasured(1:𝔹,1:𝔹,true,false,true),false),measuredPair(siblingReturnMeasured(H(0:𝔹),H(0:𝔹),true,false,false),true));
