// args: --run

def g(x:𝔹)⇒measure(x);
def f1(c:!𝔹){
	a:=vector(3,1:𝔹);
	if c { forget((a,)[1]=(1,1,1)); }
	else { forget(a=vector(3,1:𝔹)); }
}
def f2(c:!𝔹){
	a:=vector(3,1:𝔹);
	if c { assert(measure((a,)[1])); }
	else { forget(a=vector(3,1:𝔹)); }
}
def f3(c:!𝔹){
	a:=vector(3,1:𝔹);
	if c { r:=g((a,)[1]); }
	else { forget(a=vector(3,1:𝔹)); r:=true; }
	return r;
}
def f4(c:!𝔹){
	a:=vector(3,1:𝔹);
	if c { if g((a,)[1]) { return 0; } return 1; }
	forget(a=vector(3,1:𝔹));
	return 2;
}
def main(){
	f1(false);
	f2(false);
	assert(f3(false));
	assert(f4(false)==2);
}
