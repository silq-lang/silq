// args: --run

def f(){
	x:=0:𝔹;
	z:=1:𝔹;
	while measure(H(0:𝔹)){
		forget(z);
		return x;
	}
	return (x,z)[0];
}
def g(){
	x:=0;
	while measure(H(0:𝔹)){
		y:=move(x);
		return y;
	}
	return x;
}
def h(){
	x:=0;
	while measure(H(0:𝔹)){
		y:=move(x);
		return;
	}
}
def main(){
	a:=f();
	b:=g();
	h();
	assert(b=0);
	return (a,b);
}
