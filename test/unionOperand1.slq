// args: --run

def lengths(k:!ℕ):⋃[n:!ℕ]. !ℕ^(n+1)⇒vector(k+1,k);
def twice(k:!ℕ){ x:=lengths(k); return (x,x); }
def widths(k:!ℕ):⋃[n:!ℕ]. !int[n+1]⇒3:!int[k+1];
def maker(k:!ℕ):⋃[n:!ℕ]. 𝟙 !→qfree !ℕ^(n+1)⇒λ()qfree⇒vector(k+1,k);
def size[n:!ℕ](v:!ℕ^n):!ℕ⇒n;
def add[n:!ℕ](v:!ℕ^n,w:!ℕ^n):!ℕ^n{
	for i in 0..n { v[i]+=w[i]; }
	return v;
}
def indexed(){
	return (lengths(2)[1],twice(2)[0][1],lengths(3).length,lengths(1)[0..1]);
}
def operators(){
	return (lengths(1)~lengths(2),lengths(2)=lengths(2),lengths(1)≠lengths(2),widths(3)+1,-widths(2));
}
def calls(){
	return (size(lengths(4)),size(twice(1)[1]),maker(2)()[1],size(maker(3)()));
}
def conditions(){
	i:=0:!ℕ;
	while lengths(i).length<4 { i+=1; }
	b:=0:!ℕ;
	if lengths(2)[0]=2 { b+=1; }
	c:=b=1&&lengths(2)[1]=2;
	d:=(λ(k:!ℕ)⇒lengths(k)[k])(3);
	return (i,b,c,d);
}
def iterated(){
	s:=0:!ℕ;
	for x in lengths(3) { s+=x; }
	v:=[x+1 for x in lengths(2)];
	y:=lengths(2);
	y~=lengths(1);
	z:=[1,2]:!ℕ[];
	z~=lengths(1);
	return (s,v,y,z);
}
def opened(){
	(p,q):=twice(3);
	x:=twice(1)[0];
	return add(add(p,q),p)[0]+add(x,x)[1];
}
def main(){
	r:=(indexed(),operators(),calls(),conditions(),iterated(),opened());
	assert(r==((2,2,4,[1]),([1,1,2,2,2],true,true,4,-3),(5,2,2,4),(3,1,true,3),(12,[3,3,3],[2,2,2,1,1],[1,2,1,1]),11));
	return r;
}
