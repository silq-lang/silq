// args: --run

def whileLoop(const a:𝔹){
	b:=0:𝔹;
	s:=1;
	if a {
		j:=0;
		while j<3 {
			if j>=10 { s+=j; assert(false); }
			b:=X(b);
			j+=1;
		}
	}
	s+=1;
	return (measure(b),s);
}

def atEnd(const a:𝔹){
	b:=0:𝔹;
	s:=1;
	if a {
		j:=0;
		while j<3 {
			b:=X(b);
			j+=1;
			if j>=10 { s+=1; assert(false); }
		}
	}
	return (measure(b),s);
}

def nestedIf(const a:𝔹){
	b:=0:𝔹;
	s:=1;
	if a {
		j:=0;
		while j<3 {
			if j>=1 { if j>=10 { s+=j; assert(false); } b:=X(b); }
			j+=1;
		}
	}
	return (measure(b),s);
}

def branchLocal(const a:𝔹){
	b:=0:𝔹;
	w:=0:𝔹;
	s:=1;
	if a {
		k:=0;
		j:=0;
		while j<3 {
			if j>=10 { k+=1; s+=j; assert(false); }
			b:=X(b);
			k+=1;
			j+=1;
		}
		if k==3 { w:=X(w); }
	}
	return (measure(b,w),s);
}

def indexAssignment(const a:𝔹){
	b:=0:𝔹;
	arr:=[1,2,3]:!ℕ[];
	t:=(1,2):!ℕ×!ℕ;
	if a {
		j:=0;
		while j<3 {
			if j>=10 { arr[0]=5; t[1]+=j; assert(false); }
			b:=X(b);
			j+=1;
		}
	}
	return (measure(b),arr,t);
}

def main(){
	a:=1:𝔹;
	r:=(whileLoop(a),atEnd(a),nestedIf(a),branchLocal(a),indexAssignment(a));
	assert(r==((1,2),(1,1),(0,1),((1,1),1),(1,[1,2,3],(1,2))));
	return (r,measure(a));
}
