// args: --run

def withoutImplicitDup(w:𝔹){
	ms:=0:!ℕ;
	p:=dup(w);
	u:=!p; forget(u);
	if p { w:=X(w); }
	ms+=measure(p);
	return (w,ms);
}
def withoutConsumption(w:𝔹){
	ms:=0:!ℕ;
	p:=dup(w);
	ms+=measure(p);
	u:=!p; forget(u);
	if p { }
	ms+=2*measure(p);
	return (w,ms);
}
def main(){
	(w0,m0):=withoutImplicitDup(1:𝔹); (w1,m1):=withoutConsumption(1:𝔹);
	r:=((measure(w0),m0),(measure(w1),m1));
	assert(r==((0,1),(1,3)));
	return r;
}
