def consumedInElse(a:𝔹,l:!𝔹){
	v0:=!a;
	v1:=dup(v0);
	e:=v1;
	if l { a:=X(a); u:=!v1; forget(u); w:=!v0; forget(w); } else { t:=measure(v0); a:=X(a); assert(false); }
	s:=measure(v0);
	r:=measure(v1); /// error
	return (a,s,r,e);
}
def consumedInThen(a:𝔹,l:!𝔹){
	v0:=!a;
	v1:=dup(v0);
	e:=v1;
	if l { t:=measure(v0); a:=X(a); assert(false); } else { a:=X(a); u:=!v1; forget(u); w:=!v0; forget(w); } /// TODO
	s:=measure(v0);
	r:=measure(v1); /// error
	return (a,s,r,e);
}
def straightLine(a:𝔹){
	v0:=!a;
	v1:=dup(v0);
	e:=v1;
	a:=X(a); u:=!v1; forget(u); w:=!v0; forget(w);
	s:=measure(v0);
	r:=measure(v1); /// error
	return (a,s,r,e);
}
