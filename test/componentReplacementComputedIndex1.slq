// args: --run

def shifted(const j:uint[3])qfree⇒(j+1)&3;
def swapQuantum(){
	x:=[0:𝔹,1:𝔹,0:𝔹,1:𝔹];
	i:=6:uint[3];
	y:=1:𝔹;
	(x[i&3],y):=(y,x[i&3]);
	return (measure(x),measure(y),measure(i));
}
def updateQuantum(){
	x:=[0:𝔹,1:𝔹,0:𝔹,1:𝔹];
	i:=6:uint[3];
	x[i&3]:=X(x[i&3]);
	return (measure(x),measure(i));
}
def updateClassical(){
	x:=[0:𝔹,1:𝔹,0:𝔹,1:𝔹];
	k:=6:!uint[3];
	y:=1:𝔹;
	(x[k&3],y):=(y,x[k&3]);
	x[k%4]:=X(x[k%4]);
	return (measure(x),measure(y));
}
def updateNested(){
	x:=[[0:𝔹,0:𝔹],[0:𝔹,0:𝔹]];
	i:=3:uint[2];
	j:=2:uint[2];
	x[i&1][j&1]:=X(x[i&1][j&1]);
	return (measure(x),measure(i),measure(j));
}
def swapComponents(){
	x:=[0:𝔹,1:𝔹,0:𝔹,0:𝔹];
	i:=5:uint[3];
	j:=6:uint[3];
	(x[i&3],x[j&3]):=(x[j&3],x[i&3]);
	return (measure(x),measure(i),measure(j));
}
def borrowQuantum(){
	x:=[0:𝔹,1:𝔹,1:𝔹,0:𝔹];
	i:=6:uint[3];
	with { t:=x[i&3]; } do { y:=dup(t); }
	return (measure(x),measure(i),measure(y));
}
def swapCall(){
	x:=[0:𝔹,1:𝔹,0:𝔹,1:𝔹];
	i:=1:uint[3];
	y:=1:𝔹;
	(x[shifted(i)],y):=(y,x[shifted(i)]);
	x[shifted(i)]:=X(x[shifted(i)]);
	return (measure(x),measure(y),measure(i));
}
def main(){
	r:=(swapQuantum(),updateQuantum(),updateClassical(),updateNested(),swapComponents(),borrowQuantum(),swapCall());
	assert(r==(([0,1,1,1],0,6),([0,1,1,1],6),([0,1,0,1],0),([[0,0],[1,0]],3,2),([0,0,1,0],5,6),([0,1,1,0],6,1),([0,1,0,1],0,1)));
	return r;
}
