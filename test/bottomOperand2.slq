// args: --run

def compared(c:!𝔹,a:𝔹){
	if c { r:=measure(a)+(0,)[2]==0; } else { r:=measure(a)==1; }
	return r;
}
def asserted(c:!𝔹,a:𝔹){
	if c { assert(measure(a)+(0,)[2]==0); return false; }
	return measure(a);
}
def condition(c:!𝔹,a:𝔹){
	r:=false;
	if c { if measure(a)+(0,)[2]==0 { r=true; } } else { r=measure(a); }
	return r;
}
def operandAfter(c:!𝔹,a:𝔹){
	if c { r:=(0,)[2]+measure(a)==0; } else { r:=measure(a)==1; }
	return r;
}
def chained(c:!𝔹,a:𝔹,b:𝔹){
	if c { r:=measure(a)+(0,)[2]+measure(b)<3; } else { r:=measure(a)+measure(b)<2; }
	return r;
}
def less(c:!𝔹,a:𝔹){
	if c { r:=measure(a)*(2,)[1]<3; } else { r:=measure(a)<1; }
	return r;
}
def main(){
	r:=(compared(false,1:𝔹),asserted(false,1:𝔹),condition(false,1:𝔹),operandAfter(false,1:𝔹),chained(false,1:𝔹,1:𝔹),less(false,1:𝔹));
	assert(r==(true,true,true,true,false,false));
	return r;
}
