// args: --run

def f(m:!ℕ)qfree⇒m;
def explicit():!ℕ[]{
	x:=[1,2,3]:!ℕ[];
	y:=x[0..move(x).length];
	return y;
}
def bottom():𝔹[]{
	x:=[]:⊥[];
	return x[0..move(x).length];
}
def call(x:!ℕ[],n:!ℕ):!ℕ[]{
	return x[0..f(n)];
}
def other(){
	x:=[1,2,3]:!ℕ[];
	y:=[1,2]:!ℕ[];
	z:=x[1..move(y).length+1];
	return (x,z:!ℕ[]);
}
def qubits():𝔹[]{
	x:=vector(2,0:𝔹);
	x[1]:=X(x[1]);
	return x[0..move(x).length];
}
def main(){
	return (explicit(),measure(bottom()),call([1,2,3],2),other(),measure(qubits()));
}
