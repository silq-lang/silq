// args: --run

def straight(){
	x:=(0:!𝔹,1:!𝔹);
	y:=x;
	x[0]:=H(x[0]);
	z:=dup(x[1]);
	x[1]:=H(x[1]);
	x[0]:=H(x[0]);
	x[1]:=H(x[1]);
	r:=measure(x);
	r[0]:=H(r[0]);
	r[0]:=H(r[0]);
	return (measure(r),y,z);
}
def branches(c:!𝔹){
	x:=(0:!𝔹,1:!𝔹);
	if c { x[0]:=H(x[0]); x[0]:=H(x[0]); } else { x[1]:=H(x[1]); }
	x[1]:=H(x[1]);
	if c { x[1]:=H(x[1]); } else { x[1]:=X(x[1]); }
	return measure(x);
}
def controlled(){
	x:=(0:!𝔹,1:!𝔹);
	c:=H(0:𝔹);
	if c { x[0]:=X(x[0]); }
	if c { x[0]:=X(x[0]); }
	return (measure(x),measure(H(c)));
}
def loops(n:!ℕ){
	x:=(0:!𝔹,1:!𝔹);
	for i in 0..n { x[0]:=H(x[0]); }
	k:=0;
	while k<n { x[1]:=H(x[1]); k+=1; }
	repeat n { x[0]:=H(x[0]); x[1]:=H(x[1]); }
	return measure(x);
}
def swap(k:!ℕ){
	x:=(0:!𝔹,1:!ℕ,2:!ℕ,3:!ℕ);
	y:=x;
	(x[3],x[k]):=(x[k],x[3]);
	return (x,y);
}
def nested(){
	x:=((0:!𝔹,1:!𝔹),2:!ℕ);
	x[0][1]:=H(x[0][1]);
	x[0][0]:=H(x[0][0]);
	x[0][1]:=H(x[0][1]);
	x[0][0]:=H(x[0][0]);
	(a,b):=x;
	return (measure(a),b);
}
def captured(){
	x:=(0:!𝔹,1:!𝔹);
	f:=λ()⇒x;
	x[1]:=H(x[1]);
	x[1]:=H(x[1]);
	return (f(),measure(x));
}
def main(){
	r:=(straight(),branches(true),branches(false),controlled(),loops(2),loops(3),swap(0),swap(2),nested(),captured());
	return r;
}
