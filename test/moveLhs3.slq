// args: --run

def reversed(r:𝔹){
	X(move(q)):=r;
	return q;
}
def reversedTuple(x:𝔹,y:𝔹){
	def swap(a:𝔹,b:𝔹)mfree⇒(b,a);
	swap(move(u),move(v)):=(x,y);
	return (u,v);
}
def shadowedNested(y:𝔹){
	def move(z:𝔹)mfree⇒X(z);
	H(move(w)):=y;
	return w;
}
def annotated(){
	move(x):!ℕ:=3;
	(move(y):!ℕ,z):=(4,5);
	return (x,y,z);
}
def branches(c:!𝔹){
	if c { move(y):=1; } else { move(y):=2; }
	return y;
}
def vectors(){
	[move(a),b]:=[1,2];
	return (a,b);
}
def transformed(q:𝔹){
	with { move(t):=dup(q); } do { r:=dup(t); }
	return (q,r);
}
def main(){
	r:=(measure(reversed(0:𝔹)),measure(reversedTuple(0:𝔹,1:𝔹)),measure(shadowedNested(H(0:𝔹))),annotated(),branches(true),branches(false),vectors(),measure(transformed(1:𝔹)));
	assert(r==(1,(1,0),1,(3,4,5),1,2,(1,2),(1,1)));
	return r;
}
