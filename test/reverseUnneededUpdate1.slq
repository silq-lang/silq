// args: --run

def forgottenInBody(xs:𝔹^4,const c:!𝔹,const j:!ℕ)mfree{
	with { u:=3; } do { v0:=(u+j)%4; xs[1]:=X(xs[1]); v1:=(j+j)%4; if c { v1+=dup(v0); v0+=5; } forget(v1); }
	xs[(v0+3)%4]:=X(xs[(v0+3)%4]);
	return xs;
}

def outerChange(xs:𝔹^4,const c:!𝔹,const j:!ℕ)mfree{
	k:=(j+j)%4;
	with { u:=3; } do { v0:=(u+j)%4; xs[1]:=X(xs[1]); v1:=(j+j)%4; if c { v1+=dup(v0); k+=j+1; v0+=dup(k); } forget(v1); }
	xs[(v0+3)%4]:=X(xs[(v0+3)%4]);
	return xs;
}

def quantumInBranch(xs:𝔹^4,const c:!𝔹,const j:!ℕ)mfree{
	with { u:=3; } do { v0:=(u+j)%4; v1:=(j+j)%4; if c { v1+=dup(v0); v0+=5; xs[2]:=X(xs[2]); } forget(v1); }
	xs[(v0+3)%4]:=X(xs[(v0+3)%4]);
	return xs;
}

def twoUpdates(xs:𝔹^4,const c:!𝔹,const j:!ℕ)mfree{
	with { u:=3; } do { v0:=(u+j)%4; xs[1]:=X(xs[1]); v1:=(j+j)%4; if c { v1+=dup(v0); v0+=5; v1+=v0; } forget(v1); }
	xs[(v0+3)%4]:=X(xs[(v0+3)%4]);
	return xs;
}

def inLoop(xs:𝔹^4,const c:!𝔹,const j:!ℕ)mfree{
	with { u:=3; } do { v0:=(u+j)%4; xs[1]:=X(xs[1]); v1:=(j+j)%4; for i in 0..2 { v1+=dup(v0); v0+=5; } forget(v1); }
	xs[(v0+3)%4]:=X(xs[(v0+3)%4]);
	return xs;
}

def bothBranches(xs:𝔹^4,const c:!𝔹,const j:!ℕ)mfree{
	with { u:=3; } do { v0:=(u+j)%4; xs[1]:=X(xs[1]); v1:=(j+j)%4; if c { v1+=dup(v0); v0+=5; } else { v1+=v0+1; v0+=2; } forget(v1); }
	xs[(v0+3)%4]:=X(xs[(v0+3)%4]);
	return xs;
}

def notForgotten(xs:𝔹^4,const c:!𝔹,const j:!ℕ)mfree{
	with { u:=3; } do { v0:=(u+j)%4; xs[1]:=X(xs[1]); v1:=(j+j)%4; if c { v1+=dup(v0); v0+=5; } }
	xs[(v0+3)%4]:=X(xs[(v0+3)%4]);
	return xs;
}

def inOuterBranch(xs:𝔹^4,const c:!𝔹,const j:!ℕ)mfree{
	if c {
		with { u:=3; } do { v0:=(u+j)%4; xs[1]:=X(xs[1]); v1:=(j+j)%4; if c { v1+=dup(v0); v0+=5; } forget(v1); }
		xs[(v0+3)%4]:=X(xs[(v0+3)%4]);
	}
	return xs;
}

