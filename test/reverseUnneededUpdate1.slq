),measure(bothBranches((1,0,0,1):𝔹^4,true,3)),measure(reverse(bothBranches)(bothBranches((1,0,0,1):𝔹^4,true,3),true,3)),measure(notForgotten((1,1,1,0):𝔹^4,true,2)),measure(reverse(notForgotten)(notForgotten((1,1,1,0):𝔹^4,true,2),true,2)),measure(notForgotten((0,1,1,0):𝔹^4,false,2)),measure(reverse(notForgotten)(notForgotten((0,1,1,0):𝔹^4,false,2),false,2)),measure(notForgotten((1,0,0,1):𝔹^4,true,3)),measure(reverse(notForgotten)(notForgotten((1,0,0,1):𝔹^4,true,3),true,3)),measure(inOuterBranch((1,1,1,0):𝔹^4,true,2)),measure(reverse(inOuterBranch)(inOuterBranch((1,1,1,0):𝔹^4,true,2),true,2)),measure(inOuterBranch((0,1,1,0):𝔹^4,false,2)),measure(reverse(inOuterBranch)(inOuterBranch((0,1,1,0):𝔹^4,false,2),false,2)),measure(inOuterBranch((1,0,0,1):𝔹^4,true,3)),measure(reverse(inOuterBranch)(inOuterBranch((1,0,0,1):𝔹^4,true,3),true,3)));
