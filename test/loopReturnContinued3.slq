// args: --run

def copyBefore(x:𝔹,y:𝔹,k:!ℕ){
	for i in 0..3 { t:=dup(x); if k==i { u:=dup(t); forget(u); forget(t); return (x,y); } }
	return (x,y);
}
def copyImplicit(x:𝔹,k:!ℕ){
	for i in 0..3 { t:=dup(x); if k==i { u:=dup(t); forget(u); return x; } }
	return x;
}
def movedCopy(x:𝔹,k:!ℕ){
	repeat 2 { t:=dup(x); if k>0 { u:=t; forget(u); return (x,1); } }
	return (x,0);
}
def nested(x:𝔹,k:!ℕ){
	repeat 2 { t:=dup(x); if k>0 { if k>1 { forget(t); return (x,2); } forget(t); return (x,1); } }
	return (x,0);
}
def nestedElse(x:𝔹,k:!ℕ){
	repeat 2 { t:=dup(x); if k>0 { if k>1 { forget(t); return (x,2); } else { forget(t); return (x,1); } } }
	return (x,0);
}
def nestedContinued(x:𝔹,k:!ℕ){
	repeat 2 { t:=dup(x); if k>0 { if k>1 { forget(t); return (x,2); } else { forget(t); } return (x,1); } }
	return (x,0);
}
def main(){
	r:=(measure(copyBefore(1:𝔹,0:𝔹,1)),measure(copyImplicit(1:𝔹,0)),measure(movedCopy(1:𝔹,1)),measure(nested(1:𝔹,2)),measure(nested(1:𝔹,1)),measure(nested(1:𝔹,0)),measure(nestedElse(0:𝔹,2)),measure(nestedContinued(1:𝔹,1)));
	assert(r==((1,0),1,(1,1),(1,2),(1,1),(1,0),(0,2),(1,1)));
	return r;
}
