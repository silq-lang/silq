// args: --run

def f1(n:!ℕ,const a:𝔹){
	w:=0:𝔹;
	for i in 0..n { w:=X(w); w:=X(w); if a { if i<4 { w:=X(w); } else { assert(false); } } w:=(λ()⇒X(w))(); }
	return measure(w);
}
def f2(n:!ℕ,const a:𝔹){
	w:=0:𝔹;
	for i in 0..n { w:=X(w); w:=X(w); if a { if i<4 { w:=X(w); } else { assert(false); } } g:=λ()⇒X(w); w:=g(); }
	return measure(w);
}
def f3(n:!ℕ,const a:𝔹){
	w:=0:𝔹;
	for i in 0..n { if i%2==0 { w:=X(w); } else { w:=X(w); w:=X(w); } if a { if i<4 { w:=X(w); } else { assert(false); } } w:=(λ()⇒X(w))(); }
	return measure(w);
}
def f4(n:!ℕ,const a:𝔹){
	w:=0:𝔹;
	for i in 0..n { w:=X(w); w:=X(w); if a { if i<4 { w:=X(w); } else { assert(false); } } def g()⇒X(w); w:=g(); }
	return measure(w);
}
def f5(n:!ℕ,const a:𝔹){
	w:=0:𝔹; y:=0:𝔹;
	for i in 0..n { w:=X(w); y⊕=(λ()qfree⇒dup(w))(); w:=X(w); if a { if i<4 { w:=X(w); } else { assert(false); } } }
	return measure(w,y);
}
def main(){
	a:=1:𝔹;
	r:=(f1(3,a),f2(3,a),f3(3,a),f4(3,a),f5(3,a));
	assert(r==(0,0,0,0,(1,0)));
	return (r,measure(a));
}
