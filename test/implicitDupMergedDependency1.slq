def returnInNestedBranch(a:𝔹,k:!𝔹,j:!𝔹){
	ms:=0:!ℕ;
	b:=X(dup(a));
	ms+=measure(b);
	if k { if j { a:=X(a); return (a,0:𝔹,ms); } } else { }
	return (a,b,ms); /// error
}
def consumedAfter(a:𝔹,k:!𝔹,j:!𝔹){
	ms:=0:!ℕ;
	b:=X(dup(a));
	ms+=measure(b);
	if k { if j { a:=X(a); return (a,ms); } } else { }
	a:=X(a);
	ms+=measure(b); /// error
	return (a,ms);
}
def returnInElse(a:𝔹,k:!𝔹,j:!𝔹){
	ms:=0:!ℕ;
	b:=X(dup(a));
	ms+=measure(b);
	if k { } else { if j { a:=X(a); return (a,0:𝔹,ms); } }
	return (a,b,ms); /// error
}
def returnInBothBranches(a:𝔹,k:!𝔹,j:!𝔹,l:!𝔹){
	ms:=0:!ℕ;
	b:=X(dup(a));
	ms+=measure(b);
	if k { if j { a:=X(a); return (a,0:𝔹,ms); } } else { if l { a:=X(a); return (a,0:𝔹,ms); } }
	return (a,b,ms); /// error
}
def movedCopy(a:𝔹,k:!𝔹,j:!𝔹){
	ms:=0:!ℕ;
	b:=X(dup(a));
	e:=b;
	if k { if j { a:=X(a); return (a,ms,e); } } else { }
	(a,t):=(a,measure(b)); /// error
	ms+=t;
	return (a,ms,e);
}
def implicitDupInBranch(a:𝔹,k:!𝔹,j:!𝔹){
	ms:=0:!ℕ;
	b:=X(dup(a));
	if k {
		t:=measure(b);
		ms+=t;
		if j { u:=!b; forget(u); return (a,ms); }
	} else {
		if j { a:=X(a); }
	}
	(a,t):=(a,measure(b)); /// error
	ms+=t;
	return (a,ms);
}
def implicitDupInNestedBranch(a:𝔹,k:!𝔹,j:!𝔹){
	ms:=0:!ℕ;
	v:=dup(a);
	if k {
		if j { a:=X(a); return (a,ms); } else { u:=!v; forget(u); a:=X(a); }
	} else {
		if j { u:=!v; forget(u); } else { t:=measure(v); ms+=t; }
	}
	(a,t):=(a,measure(v)); /// error
	ms+=t;
	return (a,ms);
}
