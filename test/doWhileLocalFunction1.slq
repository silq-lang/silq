// args: --run

def app(f:!ℕ!→qfree !ℕ,x:!ℕ)qfree⇒f(x);
def nested(n:!ℕ){
	q:=0:𝔹; k:=0;
	do{
		k+=1;
		def g(x:!ℕ){ return x+k; }
		j:=0;
		do{ j+=1; h:=λ(x:!ℕ)⇒(app(g,x)%2,q); (y,q):=h(n+j); if y==1 { q:=X(q); } }while j<2;
	}while k<n+2;
	return (measure(q),g(10));
}
def recursive(n:!ℕ){
	q:=0:𝔹; k:=0;
	do{
		k+=1;
		def g(x:!ℕ):!ℕ{ if x==0 { return k; } return g(x sub 1)+1; }
		h:=λ(x:!ℕ)⇒(g(x)%2,q);
		(y,q):=h(n);
		if y==1 { q:=X(q); }
	}while k<n+2;
	return (measure(q),g(1));
}
def main(){
	r:=(nested(0),nested(1),recursive(0),recursive(1));
	assert(r==((0,12),(1,13),(1,3),(1,4)));
	return r;
}
