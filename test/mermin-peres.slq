// quantum pseudo-telepathy

def prepare(){
	table:=[
		[(0,[I,Z]),(0,[Z,I]),(0,[Z,Z])],
		[(0,[X,I]),(0,[I,X]),(0,[X,X])],
		[(π,[X,Z]),(π,[Z,X]),(0,[Y,Y])],
	];
	([Q1,Q3],[Q2,Q4]):=[bell() for _ in 0..2];
	def alice(j:!ℕ) ⇒ measurePss([table[j][k] for k in 0..3])(Q1,Q2);
	def bob(k:!ℕ)   ⇒ measurePss([table[j][k] for j in 0..3])(Q3,Q4);
	return (alice,bob);
}

def judge(){
	(alice,bob):=prepare();
	(j,k):=[sample() for _ in 0..2];
	row:=alice(j);
	col:=bob(k);
	return product(row)=1 && product(col)=-1 && row[k]=col[j];
}

def main(){
	for _ in 0..20{
		assert(judge());
	}
}


// helpers
def bell()⇒let x:=H(0) in [dup(x),x];
def measurePs[m:!ℕ](const θ:!ℝ,const f:(𝔹!→mfree 𝔹)^m)(q:𝔹^m){
	t:=H(0);
	if t{
		for i in 0..2{
			q[i]:=f[i](q[i])
		}
		phase(θ);
	}
	return (if measure(H(t)) then -1 else 1,q);
}
def measurePss[n:!ℕ,m:!ℕ](const params:(!ℝ×(𝔹!→mfree 𝔹)^m)^n)(q:𝔹^m){
	res:=[];
	for p in params{
		(x,q):=measurePs(p)(q);
		res~=[x];
	}
	measure(q);
	return res coerce _^n;
}

def product[n:!ℕ](const xs:!ℤ^n)⇒if n=0 then 1 else xs[0]·product(xs[1..n]);
def sample(){
	x:=rotY(2·asin(sqrt(1/3)),0);
	y:=if x=0 then H(0) else 0;
	return measure([x,y] as uint[2]) as !ℕ;
}
