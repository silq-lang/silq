// args: --run

def inLet(n:!ℕ)⇒vector(let { if n=3 { b:=vector(1,0:!𝔹); c:=vector(1,0:!𝔹); } else { b:=vector(2,0:!𝔹); c:=vector(2,0:!𝔹); } d:=b; } in d.length,1:𝔹);
def inLetTuple(n:!ℕ)⇒vector(let { if n=3 { t:=(vector(1,0:!𝔹),vector(1,0:!𝔹)); } else { t:=(vector(2,0:!𝔹),vector(2,0:!𝔹)); } } in t[0].length,1:𝔹);
def main(){
	u:=measure(inLet(3));
	v:=measure(inLetTuple(4));
	r:=(u.length,v.length);
	assert(r==(1,2));
	return r;
}
