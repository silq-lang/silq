// args: --run

a:=floor(7/2);
b:=ceil(-7/2);
c:=(round(5/2),round(-5/2));
d:=gcd(12,-18);
e:=ceil(log₂(5));
f:=floor(log₂(8));
g:=(floor(log10(999)),ceil(log10(1/999)));
h:=(ceil(sqrt(10)),floor(sqrt(9/4)));
k:=(floor(cbrt(-9)),ceil(cbrt(1/8)));
l:=(ceil(exp2(-3)),floor(exp2(10)));
def bits(n:!ℕ)=>vector(ceil(log₂(n)) coerce !ℕ,0:!𝔹);
def main(){
	r:=(a,b,c,d,e,f,g,h,k,l,bits(8):!𝔹^3,bits(5):!𝔹^3,vector(floor(1.5)+e coerce !ℕ,0:!𝔹):!𝔹^4,(1:!uint[gcd(4,6)]):!uint[2]);
	assert(r==(3,-3,(3,-2),6,3,3,(2,-2),(4,1),(-3,1),(1,1024),vector(3,0:!𝔹),vector(3,0:!𝔹),vector(4,0:!𝔹),1:!uint[2]));
	assert((a,b,c,d,e,f,g,h,k,l)==(floor(7/2),ceil(-7/2),(round(5/2),round(-5/2)),gcd(12,-18),ceil(log₂(5)),floor(log₂(8)),(floor(log10(999)),ceil(log10(1/999))),(ceil(sqrt(10)),floor(sqrt(9/4))),(floor(cbrt(-9)),ceil(cbrt(1/8))),(ceil(exp2(-3)),floor(exp2(10)))));
	return r;
}
