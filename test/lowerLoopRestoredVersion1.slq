// args: --run

def f(c:!𝔹,y:𝔹){
	if c { return y; }
	repeat 2 { o:=dup(y); forget(o); assert(false); }
	return y;
}
def g(c:!𝔹,y:𝔹,const z:𝔹){
	y⊕=z;
	if c { return y; }
	do { o:=dup(y); forget(o); assert(false); } while true;
}
def h(c:!𝔹){
	y:=H(0:𝔹);
	if c { return H(y); }
	repeat 2 { o:=dup(y); forget(o); assert(false); }
	return y;
}
def k(c:!𝔹,y:𝔹){
	if c { return y; }
	repeat 1 { o:=dup(y); forget(o); assert(false); }
}
def main(){
	a:=f(true,1:𝔹);
	b:=g(true,0:𝔹,1:𝔹);
	c:=h(true);
	d:=k(true,0:𝔹);
	r:=measure(a,b,c,d);
	assert(r==(1,1,0,0));
	return r;
}
