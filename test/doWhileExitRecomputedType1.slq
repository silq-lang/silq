// args: --run

def annotated():!𝔹[]{
	k:=0;
	do{ k+=1; v:=vector(k,1:𝔹); }while k<2{ measure(H(0:𝔹)); }
	x:=v:𝔹^k;
	return measure(x): !𝔹[];
}
def g[m:!ℕ](x:𝔹^m)⇒measure(x);
def inLoop(){
	r:=0;
	repeat 2 {
		k:=0;
		do{ k+=1; v:=vector(k,1:𝔹); }while k<1{ measure(H(0:𝔹)); }
		x:=g(v);
		r+=x.length;
	}
	return r;
}
def main(){
	r:=(annotated(),inLoop());
	assert(r==([1,1],2));
	return r;
}
