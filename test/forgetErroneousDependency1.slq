def explicit(){
	q:=H(0:𝔹);
	v:=dup(q);
	w:=dup(tqx(q)); /// error
	forget(v);
	return w;
}

def inLoop(){
	q:=H(0:𝔹);
	v:=dup(q);
	w:=dup(tqx(q)); /// error
	for j in [0..2){
		for i in [0..3){
			forget(v);
			v:=dup(w);
		}
	}
	return (w,v);
}

def inBranch(c:!𝔹){
	q:=H(0:𝔹);
	v:=dup(q);
	if c {
		w:=dup(tqx(q)); /// error
	} else {
		w:=dup(q);
	}
	forget(v);
	return w;
}
