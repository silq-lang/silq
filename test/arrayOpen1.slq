// args: --run

def appended():⋃[n:!ℕ]. !ℕ^(n+1){
	a:=vector(2,0):!ℕ[];
	if measure(H(0)){
		x:=a~[1];
	}else{
		x:=a~[1];
	}
	return x;
}
def duplicated():⋃[n:!ℕ]. (!ℕ^n)^2{
	a:=vector(2,0):⋃[n:!ℕ]. !ℕ^n;
	x:=(a,a);
	return x;
}
def assigned():⋃[n:!ℕ]. (!ℕ^n)^2{
	a:=[1]:!ℕ[];
	a=[2,3]:!ℕ[];
	return (a,a);
}
def main(){
	r:=(appended(),duplicated(),assigned());
	assert(r==((0,0,1),((0,0),(0,0)),((2,3),(2,3))));
	return r;
}
