// args: --run

def lastUseBeforeConsumption(w:𝔹,k:!𝔹){
	ms:=0:!ℕ;
	cp:=dup(w);
	p:=dup(cp);
	if k { w:=X(w); } else { t:=measure(p); ms+=t; }
	ms+=2*measure(p);
	w:=X(w);
	return (w,ms);
}
def consumedAfterControl(w:𝔹,k:!𝔹){
	ms:=0:!ℕ;
	cp:=dup(w);
	p:=dup(cp);
	if p { w:=X(w); }
	if k { ms+=1; } else { ms+=2; }
	ms+=4*measure(p);
	return (w,ms);
}
def main(){
	(w0,m0):=lastUseBeforeConsumption(1:𝔹,true); (w1,m1):=lastUseBeforeConsumption(1:𝔹,false);
	(w2,m2):=consumedAfterControl(1:𝔹,true); (w3,m3):=consumedAfterControl(0:𝔹,false);
	r:=((measure(w0),m0),(measure(w1),m1),(measure(w2),m2),(measure(w3),m3));
	assert(r==((1,2),(0,3),(0,5),(0,2)));
	return r;
}
