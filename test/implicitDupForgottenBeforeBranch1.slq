def consumedInBranch(a:𝔹,k:!𝔹){
	ms:=0:!ℕ;
	v0:=X(dup(a));
	v1:=dup(v0);
	v2:=!v1;
	if k {
		u:=!v1;
		a:=X(a); /// note
		t1:=measure(v2); /// note
		ms+=t1;
		t2:=measure(v2); /// error
		ms+=t2;
	}
	return (a,ms);
}
def usedAfterConditional(a:𝔹,k:!𝔹){
	ms:=0:!ℕ;
	v0:=X(dup(a));
	v1:=dup(v0);
	v2:=!v1;
	if k {
		u:=!v1;
		a:=X(a); /// note
		t1:=measure(v2); /// note
		ms+=t1;
	}
	t2:=measure(v2); /// error
	ms+=t2;
	return (a,ms);
}
def elseBranch(a:𝔹,k:!𝔹){
	ms:=0:!ℕ;
	v0:=X(dup(a));
	v1:=dup(v0);
	v2:=!v1;
	if k {
	} else {
