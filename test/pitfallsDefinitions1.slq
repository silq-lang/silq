def python(){
	x = 3; /// error
	y = x + 1; /// error
	return (x,y);
}

def annotated(){
	x:!ℕ = 3; /// error
	return x;
}

def constant(){
	const c = 3; /// error
	return c;
}

def qubits(){
	q = H(0:𝔹); /// error
	q := X(q);
	return measure(q);
}

def tuples(){
	(a, b) = (H(0:𝔹), 0:𝔹); /// error
	return (a,b);
}

def swap(){
	a := H(0:𝔹);
	b := 0:𝔹;
	a, b = b, a; /// error
	return (a,b);
}

def multiple(){
	a, b = H(0:𝔹), 0:𝔹; /// error
	return (a,b);
}

def goStyle(){
	a, b := H(0:𝔹), 0:𝔹; /// error
	return (a,b);
}

def assignments(){
	x:=1,y:=3;
	x,y=1,3 /// error
}

def updates(){
	a:=[1,2];
	a[0],a[1]=3,4; /// error
	return a;
}
