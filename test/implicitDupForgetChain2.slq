	ms:=0:!ℕ;
	v0:=!a;
	v1:=X(dup(v0));
	v2:=!v1;
	e:=v2;
	if k { a:=X(a); } else { t2:=measure(v1); ms+=t2; }
	return (a,ms,e);
}
