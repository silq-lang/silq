	v1:=X(dup(v0));
	v2:=!v1;
	e:=v2;
	if k { a:=X(a); t1:=measure(v2); ms+=t1; t2:=measure(v1); ms+=t2; } else { t3:=measure(v1); ms+=t3; a:=X(a); }
