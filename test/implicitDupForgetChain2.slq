def measuredBeforeConsumption(a:𝔹,k:!𝔹){
	ms:=0:!ℕ;
	v0:=!a;
	v1:=X(dup(v0));
	v2:=!v1;
	e:=v2;
	if k { t1:=measure(v2); ms+=t1; a:=X(a); } else { t2:=measure(v1); ms+=t2; }
	return (a,ms,e);
}
def forgottenAndMeasuredBeforeConsumption(a:𝔹,k:!𝔹){
	ms:=0:!ℕ;
	v0:=!a;
	v1:=X(dup(v0));
	v2:=!v1;
	e:=v2;
	if k { u:=!v0; forget(u); t1:=measure(v2); ms+=t1; a:=X(a); } else { t2:=measure(v1); ms+=t2; }
	return (a,ms,e);
}
def notUsedAfterConsumption(a:𝔹,k:!𝔹){
	ms:=0:!ℕ;
