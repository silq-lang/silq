}
def keptInElseBranch(a:𝔹,k:!𝔹){
	ms:=0:!ℕ;
	v0:=!a;
	v1:=X(dup(v0));
	v2:=!v1;
	e:=v2;
	if k { t3:=measure(v1); ms+=t3; } else { a:=X(a); t1:=measure(v2); ms+=t1; t2:=measure(v1); ms+=t2; }
	return (a,ms,e);
}
def keptInBothBranches(a:𝔹,k:!𝔹){
	ms:=0:!ℕ;
	v0:=!a;
	v1:=X(dup(v0));
	v2:=!v1;
	e:=v2;
	if k { a:=X(a); t1:=measure(v2); ms+=t1; t2:=measure(v1); ms+=t2; } else { t3:=measure(v0); ms+=t3; t4:=measure(v1); ms+=t4; }
	return (a,ms,e);
}
def consumedAfterMeasureInOtherBranch(a:𝔹,k:!𝔹){
	ms:=0:!ℕ;
