// args: --run

def componentUpdate(){
	t:=[1,2];
	v:=vector(t[0],0:𝔹);
	t[0]=5;
	w:=measure(v);
	return (w.length,w:!𝔹[],t);
}
def tupleComponentUpdate(){
	t:=(2,3);
	v:=vector(t[1],1:!𝔹);
	t[1]=0;
	return (v:!𝔹[],t);
}
def nestedComponentUpdate(){
	t:=[[1,2],[3]];
	v:=vector(t[0][1],1:!𝔹);
	t[0][1]+=1;
	w:=vector(t[0][1],0:!𝔹);
	return (v:!𝔹[],w:!𝔹[],t);
}
def loopUpdate(const x:𝔹){
	t:=[2,3];
	q:=vector(t[0],dup(x));
	for j in 0..2 {
		forget(q); q:=vector(t[0],dup(x));
		c:=0;
		do{ c+=1; t[1]=5; }while c<2;
		forget(c);
		forget(q); q:=vector(t[0],dup(x));
	}
	return (t,measure(q));
}
def main(){
	x:=1:𝔹;
	r:=(componentUpdate(),tupleComponentUpdate(),nestedComponentUpdate(),loopUpdate(x));
	forget(x=1:𝔹);
	assert(r==((1,[0],[5,2]),([1,1,1],(2,0)),([1,1],[0,0,0],[[1,3],[3]]),([2,5],[1,1])));
	return r;
}
