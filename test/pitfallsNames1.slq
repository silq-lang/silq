def cases(){
	x:=h(0:𝔹); /// error
	y:=Measure(x); /// error
	z:=rotx(0.5,0:𝔹); /// error
	return (y,z);
}

def gates(){
	a:=0:𝔹; b:=0:𝔹; c:=0:𝔹;
	b:=CX(a,b); /// error
	a:=Rz(0.5,a); /// error
	(a,b,c):=Toffoli(a,b,c); /// error
	(a,b):=SWAP(a,b); /// error
	return (M(a),b,c); /// error
}

def types(){
	q:=0:qubit; /// error
	r:=0.5:float; /// error
