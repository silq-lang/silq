}

def builtins(){
	x:=vector(3,0:𝔹);
	n:=len(x); /// error
	s:=0;
	for i in range(n){ /// error
		s+=i;
	}
	return x;
}

def keywords(a:!𝔹){
	b:=not (a); /// error
	if a { } elif(a); /// error
