// args: --remove-loops --run

def f(c:!ℕ,q0:𝔹){
	q1:=0:𝔹; a:=0:𝔹;
	t:=dup(q1);
	if t { a:=X(a); }
	repeat 3 {
		if c==1 { return (q0,q1,a); }
		if q0 { q1:=X(q1); }
	}
	return (q0,q1,a);
}
def main(){
	assert(measure(f(1,1:𝔹))==(1,0,0));
	assert(measure(f(0,1:𝔹))==(1,1,0));
	assert(measure(f(2,0:𝔹))==(0,0,0));
}
