// args: --run

def f[n:!ℕ](x:𝔹^n)⇒x;
def g[b:!𝔹](x:if b then 𝔹 else !𝔹)⇒x;

def main(){
	x:=vector(if true then 2 else 3,0:𝔹);
	y:=x:𝔹^2;
	z:=f[if 1+1==2 then 2 else 3](y);
	u:=g[true](H(0:𝔹));
	v:=g[false](1:!𝔹);
	w:=vector(if 1+1==3 then 2 else 3,0:𝔹):𝔹^3;
	assert(measure(z,w)==((0,0),(0,0,0))&&v);
	return measure(H(u));
}
