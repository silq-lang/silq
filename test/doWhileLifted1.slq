// args: --remove-loops --run

def body(const a:𝔹){
	x:=dup(a); c:=0; do{
		x⊕=1;
		c+=1;
		m:=measure(x);
	}while c<3;
	return (c,m,measure(x));
}
def reset(const a:𝔹){
	x:=dup(a); c:=0;
	do{
		c+=1;
		m:=measure(x);
	}while c<3 { x⊕=1; }
	return (c,m,measure(x));
}
def twoClasses(const a:𝔹,const b:𝔹){
	x:=dup(a);
	z:=dup(b);
	c:=0;
	do{
		x⊕=1;
		z⊕=x;
		c+=1;
		m:=measure(z);
	}while c<4;
	return (c,m,measure(x),measure(z));
}
def nestedFor(const a:𝔹){
	x:=dup(a);
	c:=0;
	do{
		for i in 0..2 { x⊕=1; }
		c+=1;
		m:=measure(x);
	}while c<2;
	return (c,m,measure(x));
}
def nestedWhile(const a:𝔹){
	x:=dup(a);
	c:=0;
	do{
		k:=0;
		while k<c {x⊕=1; k+=1; }
		c+=1; m:=measure(x);
	}while c<3;
	return (c,m,measure(x));
}
def nestedDoWhile(const a:𝔹){
	x:=dup(a);
	c:=0;
	do{
		k:=0;
		do{ x⊕=1; k+=1; }
		while k<2 { m:=measure(x); }
		c+=1;
	}while c<2;
	return (c,k,measure(x));
}
def inWhile(const a:𝔹){
	x:=dup(a);
	c:=0;
	while c<3 {
		k:=0;
		do{ x⊕=1; k+=1; }
		while k<c+1;
		c+=1;
		m:=measure(x);
	}
	return (c,measure(x));
}
def exitDefinition(const a:𝔹){
	x:=dup(a);
	c:=0;
	do{
		x⊕=1;
		c+=1;
		y:=dup(x);
		m:=measure(x);
	}while c<3;
	return (c,measure(y),measure(x));
}
def exitDefinitionChanged(const a:𝔹,const b:𝔹){
	x:=dup(a);
	z:=dup(b);
	c:=0;
	do{
		c+=1;
		y:=dup(x);
		x⊕=z;
		m:=measure(y);
	}while c<3;
	return (c,m,measure(y),measure(x));
}
def exitDefinitionOnly(const a:𝔹){
	c:=0;
	do{
		c+=1;
		y:=dup(a);
		y⊕=1;
		m:=measure(y);
	}while c<2;
	return (c,m,measure(y));
}
def main(){
	r:=(body(false),body(true),reset(false),reset(true),twoClasses(false,true),twoClasses(true,true),nestedFor(true),nestedWhile(true),nestedDoWhile(true),
		inWhile(false),inWhile(true),exitDefinition(false),exitDefinition(true),exitDefinitionChanged(true,true),exitDefinitionChanged(true,false),exitDefinitionOnly(false));
	assert(r==((3,1,1),(3,0,0),(3,0,0),(3,1,1),(4,1,0,1),(4,1,1,1),(2,1,1),(3,0,0),(2,2,1),(3,0),(3,1),(3,1,1),(3,0,0),(3,1,1,0),(3,1,1,1),(2,1,1)));
	return r;
}
