// args: --remove-loops --run

def g(const c:𝔹,i:!ℕ)qfree:𝔹{
	assert(i<1);
	return dup(c);
}
def f(const a:𝔹,const q:𝔹){
	c:=dup(a);
	d:=0:𝔹;
	for i in [0..3){
		c⊕=1;
		if q {
			t:=g(dup(c),i);
			if t { d:=H(d); }
			forget(t);
		}
	}
	return d;
}
def main(){
	a:=H(0:𝔹);
	q:=0:𝔹;
	r:=f(a,q);
	return (a,q,r);
}
