def hadamard(){
	x:=0:𝔹;
	H(x); /// error
	return x;
}

def rotation(){
	x:=0:𝔹;
	rotX(0.5,x); /// error
	return x;
}

def noEffect(){
	x:=0:𝔹;
	X(x); /// warning
	y:=vector(2,0:𝔹);
	CNOT(x,y[0]); /// warning
	return (x,y);
}

def components[n:!ℕ](x:𝔹^n){
	for i in [0..n){
		H(x[i]); /// error
	}
	return x;
}

def cnot(){
	a:=H(0:𝔹); /// note
	b:=0:𝔹;
	(a,b):=CNOT(a,b); /// error
	return (a,b);
}

def phaseShift(){
	q:=H(0:𝔹);
	phase(0.5,q); /// error
	return q;
}

def increment(){
	x:=0;
	x++; /// error
	return x;
}
