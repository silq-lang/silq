// args: --run

def f2(){
	n:=3;
	a:=vector(n,0:𝔹);
	if true {
		a[0]:=X(a[0]);
		def g(c:!𝔹){ if c { return 0; } w:=move(n); return 1; }
	}
	return measure(a)[0];
}
def f3(d:!ℕ){
	coeffs:=vector(d+1,1:!ℝ);
	coeffs[0]=2;
	def g(c:!𝔹){ if c { return 0; } w:=move(d); return 1; }
	return coeffs;
}

def main()⇒(f2(),f3(2));
