// args: --run

def lengthRead(){
	n:=2;
	x:=H(0:𝔹);
	q:=vector(n,dup(x));
	r:=q.length;
	m:=measure(H(x));
	return (n,m,r);
}
def lengthSum(){
	n:=2;
	x:=H(0:𝔹);
	q:=vector(n,dup(x));
	r:=q.length+1;
	m:=measure(H(x));
	return (m,r);
}
def lengthAfterDecay(){
	n:=2;
	x:=H(0:𝔹);
	q:=vector(n,dup(x));
	n+=1;
	r:=q.length;
	m:=measure(H(x));
	return (n,m,r);
}
def main(){
	r:=(lengthRead(),lengthSum(),lengthAfterDecay());
	assert(r==((2,0,2),(0,3),(3,0,2)));
	return r;
}
