def g(){
	w:=H(0:𝔹);
	q:=dup(w); /// error
	if measure(H(0:𝔹)) {
		m1:=measure(dup(q),q);
		if measure(H(0:𝔹)) {
			m2:=measure(q,w); /// error
			w:=H(0:𝔹);
		}
	}
	return w;
}
