// args --run

def f(){
	w:=H(0:𝔹);
	q:=dup(w);
	if measure(H(0:𝔹)) {
		m1:=measure(q);
		if measure(H(0:𝔹)) {
			m2:=measure(q);
			w:=X(w);
		}
	}
	return w;
}
def g(){
	w:=H(0:𝔹);
	q:=dup(w);
	if measure(H(0:𝔹)) {
		m1:=measure(dup(q),q);
		if measure(H(0:𝔹)) {
			m2:=measure(q,w);
			w:=H(0:𝔹);
		}
	}
	return w;
}

def main()⇒(f(),g());
