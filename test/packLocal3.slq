// args: --run

def add[n:!ℕ](v:!ℕ^n,w:!ℕ^n):!ℕ^n{
	r:=vector(n,0:!ℕ);
	for i in 0..n { r[i]=v[i]+w[i]; }
	return r;
}
def separate(k:!ℕ,c:!𝔹){
	if c { n:=k+1; x:=vector(n,1:!ℕ); y:=vector(n,2:!ℕ); } else { x:=vector(1,1:!ℕ); y:=vector(1,2:!ℕ); }
	return add(x,y);
}

def main() ⇒ (add([1,2,3],[3,4,5]), separate(2,0), separate(3,1));
