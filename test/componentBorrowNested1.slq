def fl[n:!ℕ](v:𝔹^n)qfree{
	v[0]:=X(v[0]);
	return v;
}
def wholeEnclosing(){
	a:=((1,0),(1,1)):(𝔹^2)^2;
	with { t:=a[1][0]; } do { y:=dup(a[1]); forget(y); } /// error
	return a;
}
def writeEnclosing(a:(𝔹^2)^2){
	with { t:=a[1][0]; } do { a[1]:=fl(a[1]); } /// error
	return a;
}
def borrowEnclosing(){
	a:=((1,0),(1,1)):(𝔹^2)^2;
	with { t:=a[1][0]; } do { with { u:=a[1]; } do { u[0]:=X(u[0]); } } /// error
	return a;
}
def sameTransformation(a:(𝔹^2)^2){
	with { t:=a[1][0]; u:=a[1]; } do { } /// error
	return a;
}
def writeInTransformation(a:(𝔹^2)^2){
	with { t:=a[1][0]; a[1]:=fl(a[1]); } do { } /// error
	return a;
}
def slice(){
	a:=((1,0,1),(1,1,0)):(𝔹^3)^2;
	with { t:=a[1][0]; } do { y:=dup(a[1][1..3]); forget(y); } /// error
	return a;
}
def unknownIndex(i:!ℕ){
	a:=((1,0),(1,1)):(𝔹^2)^2;
	with { t:=a[i][0]; } do { y:=dup(a[1]); forget(y); } /// error
	return a;
}
def rightHandSide(){
	a:=((1,0),(1,1)):(𝔹^2)^2;
	a[1][0]:=let { y:=dup(a[1]); forget(y); } in X(a[1][0]); /// error
	return a;
}
def assignment(){
	a:=((1,0),(1,1)):(𝔹^2)^2;
	(a[1],a[1][0]):=(a[1],a[1][0]); /// error
	return a;
}
def assignmentInner(){
	a:=((1,0),(1,1)):(𝔹^2)^2;
	(a[1][0],a[1]):=(X(a[1][0]),a[1]); /// error
	return a;
}
