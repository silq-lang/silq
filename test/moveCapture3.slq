// args: --run

def g(const h:𝟙→!ℕ)⇒h();

def main(){
	a:=1:!ℕ;
	r:=(λ()⇒move(a))();
	a:=2:!ℕ;
	s:=g(λ()⇒move(a)+1);
	a:=[3,4]:!ℕ^2;
	t:=[λ()⇒move(a)[1]][0]();
	a:=5:!int[4];
	u:=[(move(a) as !ℤ)+i for i in [0..2)];
	a:=6:!ℕ;
	q:=H(0:𝔹);
	(v,w):=(λ()⇒(move(a),dup(q)))();
	forget(w=dup(q));
	a:=7:!ℕ;
	assert((r,s,t,u,v,a)==(1,3,4,(5,6),6,7));
	return measure(H(q));
}
