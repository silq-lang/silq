// args: --run

def h(x:𝔹){ return measure(x); }

def consumedBeforeNestedReturn(a:𝔹,k:!𝔹,l:!𝔹,j:!𝔹){
	v0:=dup(a);
	v1:=!v0;
	t1:=h(v1);
	if l { if k { t2:=h(v0); x3:=(a,true); return (x3,t1,t2,t2); } }
	if j { x5:=(a,true); t6:=measure(v1); assert(false); }
	t7:=measure(v1);
	t8:=measure(v0);
	return ((a,true),t1,t7,t8);
}

def returnedBeforeAbort(a:𝔹,k:!𝔹,m:!𝔹){
	v0:=dup(a);
	v1:=!v0;
	t1:=h(v1);
	if m {
		if !k { return (a,false,false); }
		x2:=(a,true);
		t3:=h(v1);
		assert(false);
	}
	forget(v0);
	t8:=measure(v1);
	return (a,t1,t8);
}

def returnOrAbort(a:𝔹,k:!𝔹,l:!𝔹,m:!𝔹){
	v0:=dup(a);
	v1:=dup(v0);
	t1:=h(v1);
	if l {
		if k {
			if m { t2:=measure(dup(v0)); return (a,t1,t2); }
			x3:=(a,true);
			assert(false);
		}
	} else {
		a:=X(a);
		t4:=measure(v1);
		t5:=measure(v0);
		return (a,t4,t5);
	}
	t6:=measure(v1);
	t7:=measure(v0);
	return (a,t6,t7);
}

def forgottenBeforeQuantumReturns(x:𝔹,y:𝔹,const q:𝔹,k:!ℕ){
	t:=dup(x); u:=dup(t);
	if k>2 { forget(t); if q { return (x,y); } else { return (x,y); } } else { y:=X(y); }
	forget(u);
	return (x,y);
}

def main(){
	q:=H(0:𝔹);
	r:=(measure(consumedBeforeNestedReturn(1:𝔹,false,true,false)),measure(consumedBeforeNestedReturn(1:𝔹,true,true,false)),measure(returnedBeforeAbort(1:𝔹,false,true)),measure(returnedBeforeAbort(0:𝔹,true,false)),measure(returnOrAbort(1:𝔹,true,true,true)),measure(returnOrAbort(1:𝔹,false,false,false)),measure(returnOrAbort(0:𝔹,false,true,false)),measure(forgottenBeforeQuantumReturns(1:𝔹,0:𝔹,q,0)),measure(forgottenBeforeQuantumReturns(0:𝔹,1:𝔹,q,3)),measure(H(q)));
	assert(r==(((1,1),0,0,1),((1,1),0,1,1),(1,0,0),(0,1,1),(1,1,1),(0,1,1),(0,0,0),(1,1),(0,1),0));
	return r;
}
