// args: --run

def f(const c:!𝔹,n:!ℕ){
	x:=vector(n,0:𝔹);
	q:=0:𝔹;
	k:=0;
	while k<2 {
		k+=1;
		if c&&k==2 { return (measure(x:𝔹[]),measure(q),n); }
		q:=X(q);
	}
	y:=measure(x:𝔹[]);
	n+=1;
	return (y,measure(q),n);
}

def g(const c:!𝔹,n:!ℕ){
	x:=vector(n,0:𝔹);
	q:=0:𝔹;
	for k in 1..3 {
		if c&&k==2 { measure(x); return (measure(q),n); }
		x:=x coerce 𝔹^n;
		q:=X(q);
	}
	forget(x);
	n+=1;
	return (measure(q),n);
}

def h(const c:!𝔹,n:!ℕ){
	x:=vector(n,0:𝔹);
	q:=0:𝔹;
	k:=0;
	while k<2 {
		k+=1;
		if c&&k==2 { measure(x); return (measure(q),n); }
		q:=X(q);
		if q { x[0]:=X(x[0]); x[0]:=X(x[0]); }
	}
	y:=x:𝔹[];
	n+=1;
	measure(y);
	return (measure(q),n);
}

def main(){
	assert(f(true,2)==([0,0],1,2)&&f(false,2)==([0,0],0,3));
	assert(g(true,2)==(1,2)&&g(false,2)==(0,3));
	assert(h(true,2)==(1,2)&&h(false,2)==(0,3));
}
