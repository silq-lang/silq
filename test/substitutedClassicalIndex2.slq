// args: --run

__c:=(1,0);
def lengths(t:!ℕ^2,i:!ℕ){ return vector(t[i],0:𝔹); }
def lengths3(t:!ℕ^3,i:!ℕ){ return vector(t[i]+1,0:𝔹); }
def array(t:!ℕ[],i:!ℕ){ return vector(t[i],0:𝔹); }
def tupleLiteral(i:!ℕ){
	x:=lengths((1,0),i);
	for q in 0..x.length { x[q]:=X(x[q]); }
	return measure(x);
}
def variable(i:!ℕ){
	c:=(0,1);
	x:=lengths(c,i);
	for q in 0..x.length { x[q]:=X(x[q]); }
	return measure(x);
}
def booleans(i:!ℕ){
	c:=(true,false);
	x:=lengths(c,i);
	for q in 0..x.length { x[q]:=X(x[q]); }
	return measure(x);
}
def topLevel(i:!ℕ){
	x:=lengths(__c,i);
	for q in 0..x.length { x[q]:=X(x[q]); }
	return measure(x);
}
def vectorOfBits(i:!ℕ){
	c:=vector(3,true);
	x:=lengths3(c,i);
	for q in 0..x.length { x[q]:=X(x[q]); }
	return measure(x);
}
def arrayOfBits(i:!ℕ){
	c:=[true,false,true];
	x:=array(c,i);
	for q in 0..x.length { x[q]:=X(x[q]); }
	return measure(x);
}
def main(){
	r:=(tupleLiteral(0),tupleLiteral(1),variable(1),booleans(0),topLevel(0),vectorOfBits(2),arrayOfBits(1));
	assert(r==([1],[],[1],[1],[1],[1,1],[]));
	return r;
}
