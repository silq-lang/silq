// args: --run

def f[τ:*[]](xs:∏ τ)⇒xs;
def g[n:!ℕ][τ:*^n](xs:∏ τ)⇒xs;
def h[τ:*[]](xs:∏ τ):∏ τ⇒f[τ](xs);
def main(){
	a:=f[[𝔹,uint[2]]](1:𝔹,3:uint[2]);
	b:=g[2][(𝔹,uint[2])](0:𝔹,2:uint[2]);
	c:=h[[𝔹[],!ℕ]]([1:𝔹,0:𝔹],5);
	d:=f(1,2:uint[2]);
	e:=f[[𝔹,𝔹]](H(0:𝔹),0:𝔹);
	(e0,e1):=e;
	e0:=H(e0);
	r:=measure(a,b,c,d,e0,e1);
	assert(r=((1,3),(0,2),([1,0],5),(1,2),0,0));
	return r;
}
