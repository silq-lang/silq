// args: --remove-loops --run

def f(c0:!ℕ,const qc:𝔹,q0:𝔹){
	q1:=0:𝔹; a:=0:𝔹;
	repeat 3 {
		repeat 3 {
			c0+=1;
			if c0%2==0 {
				q1:=X(q1);
				t:=dup(q0); if t { a:=X(a); }
			}
		}
		if qc { return (q0,q1,a); }
	}
	return (q0,q1,a);
}
def main(){
	assert(measure(f(0,1:𝔹,1:𝔹))==(1,1,1));
	assert(measure(f(1,1:𝔹,1:𝔹))==(1,0,0));
	assert(measure(f(0,0:𝔹,1:𝔹))==(1,0,0));
	assert(measure(f(1,0:𝔹,0:𝔹))==(0,1,0));
}
