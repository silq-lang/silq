// args: --run

def literal(){
	for i in [0,1] { return 1; }
	return 0;
}
def withWork(){
	s:=0;
	for i in [1,2,3] { s+=i; return s; }
	return 10;
}
def parameterVector(xs:!ℕ^2){
	for x in xs { return x; }
	return 0;
}
def tupleLiteral(){
	for i in (2,3) { return i; }
	return 0;
}
def mixedTuple(){
	for x in (1,2.5) { return x; }
	return 0;
}
def typeVariable(){
	t:=!ℕ^2;
	xs:=(7,8):t;
	for x in xs { return x; }
	return 0;
}
def main(){
	r:=(literal(),withWork(),parameterVector((5,6)),tupleLiteral(),mixedTuple(),typeVariable());
	assert(r==(1,1,5,2,1,7));
	return r;
}
