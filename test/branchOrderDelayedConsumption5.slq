def g(const x:𝔹){ return measure(dup(x)); }
def pair(x:𝔹,const y:𝔹)mfree{ return (x,dup(y)); }
def constOperand(a:𝔹,k:!𝔹,l:!𝔹){
	v0:=dup(a);
	v1:=dup(v0); /// error
	t1:=measure(v1);
	if l {
		x:=pair(a,v1); /// note
		t:=g(v1); /// note
		assert(false);
	}
	if k {
		y:=(a,true);
		u:=measure(v0);
		assert(false);
	}
	t2:=measure(v0); /// note
	forget(v1); /// error
	return (a,t1,t2);
}
