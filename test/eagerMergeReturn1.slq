def nestedReturnThen(c:!𝔹,d:!𝔹){
	if c { if d { return (0:!𝔹,1:!𝔹); } x:=H(H(1:𝔹)); y:=dup(x); } else { x:=H(H(0:𝔹)); y:=!x; } /// TODO
	z:=dup(y);
	return (measure(x),measure(z));
}
def returnAfterDefinition(c:!𝔹,d:!𝔹){
	if c { x:=H(H(1:𝔹)); y:=dup(x); if d { return (measure(x),measure(y)); } } else { x:=H(H(0:𝔹)); y:=!x; } /// TODO
	z:=dup(y);
	return (measure(x),measure(z));
}
def nestedReturnElse(c:!𝔹,d:!𝔹){
	if c { x:=H(H(1:𝔹)); y:=dup(x); } else { if d { return (1:!𝔹,1:!𝔹); } x:=H(H(0:𝔹)); y:=!x; } /// TODO
	z:=dup(y);
	return (measure(x),measure(z));
}
def returnWithParameter(a:𝔹,c:!𝔹,d:!𝔹){
	if c { x:=H(H(1:𝔹)); y:=dup(x); if d { return (measure(x),measure(y),measure(a)); } } else { x:=H(H(0:𝔹)); y:=!x; } /// TODO
	z:=dup(y);
	return (measure(x),measure(z),measure(a));
}
