// args: --run

def withoutImplicitDup(w:𝔹){
	p:=dup(w);
	if p { w:=X(w); }
	return (w,p);
}
def unrelatedConsumption(w:𝔹,z:𝔹){
	ms:=0:!ℕ;
	p:=dup(w);
	ms+=measure(p);
	if p { z:=X(z); }
	ms+=2*measure(p);
	return (w,z,ms);
}
def consumedAfterControl(w:𝔹){
	ms:=0:!ℕ;
	p:=dup(w);
	ms+=measure(p);
	if p { }
	w:=X(w);
	return (w,ms);
}
def main(){
	(w0,p0):=withoutImplicitDup(1:𝔹);
	(w1,z1,m1):=unrelatedConsumption(1:𝔹,0:𝔹);
	(w2,m2):=consumedAfterControl(1:𝔹);
	r:=(measure(w0),measure(p0),measure(w1),measure(z1),m1,measure(w2),m2);
	assert(r==(0,1,1,1,3,0,1));
	return r;
}
