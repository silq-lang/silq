def app0(xs:𝔹^2)⇒xs~[0];

def strong(){
	xs:=vector(2,vector(2,0:𝔹));
	xs[0]:=app0(tqx(xs[0])); /// error
	ys:=xs:(𝔹^3)×(𝔹^2);
	return ys;
}

def pair(){
	xs:=vector(3,vector(2,0:𝔹));
	(xs[0],xs[1]):=(app0(xs[1]),tqx(xs[0])); /// error
	ys:=xs:𝔹^3×𝔹^4×𝔹^2;
	return ys;
}

def dependent(){
	k:=H(0:𝔹);
	x:=(vector(2,dup(k)),vector(2,dup(k)));
	x[0][0]:=X(tqx(x[0][0])); /// error
	return k;
}

def updated(){
	k:=H(0:𝔹);
	x:=(vector(2,dup(k)),vector(2,dup(k)));
	x[0][0]+=tqx(1); /// error
	return k;
}
