// args: --run

def updateRead(x:𝔹,const n:!ℕ,const c:!ℕ)qfree{
	y:=let { a:=(dup(n),1):!ℕ^2; a[0]+=c; z:=if a[0]==3 { X(x) } else { x }; } in z;
	return y;
}
def swapRead(x:𝔹,const n:!ℕ)qfree{
	y:=let { a:=(dup(n),1):!ℕ^2; (a[0],a[1]):=(a[1],a[0]); z:=if a[1]==2 { X(x) } else { x }; } in z;
	return y;
}
def readBeforeAndAfter(x:𝔹,const n:!ℕ,const c:!ℕ)qfree{
	y:=let { a:=(dup(n),1):!ℕ^2; z:=if a[0]==2 { X(x) } else { x }; a[0]+=c; w:=if a[0]==3 { X(z) } else { z }; } in w;
	return y;
}
def nestedVector(x:𝔹,const n:!ℕ,const c:!ℕ)qfree{
	y:=let { a:=((1,dup(n)),(1,1)):(!ℕ^2)^2; a[0][1]+=c; z:=if a[0][1]==3 { X(x) } else { x }; } in z;
	return y;
}
def variableIndex(x:𝔹,const n:!ℕ,const c:!ℕ)qfree{
	y:=let { a:=(dup(n),1):!ℕ^2; i:=c%2; a[i]+=c; z:=if a[0]==3 { X(x) } else { x }; } in z;
	return y;
}
def inLoop(x:𝔹,const n:!ℕ,const c:!ℕ)qfree{
	y:=let { a:=(dup(n),1):!ℕ^2; for j in 0..2 { a[j]+=c; x:=if a[j]==3 { X(x) } else { x }; } } in x;
	return y;
}
def main(){
	r:=(measure(reverse(updateRead)(1:𝔹,2,1)),measure(reverse(updateRead)(1:𝔹,1,1)),measure(reverse(swapRead)(1:𝔹,2)),measure(reverse(swapRead)(1:𝔹,1)),measure(reverse(readBeforeAndAfter)(1:𝔹,2,1)),measure(reverse(readBeforeAndAfter)(1:𝔹,1,2)),measure(reverse(readBeforeAndAfter)(1:𝔹,2,2)));
	assert(r==(0,1,0,1,1,0,0));
	s:=(measure(reverse(nestedVector)(1:𝔹,2,1)),measure(reverse(nestedVector)(1:𝔹,1,1)),measure(reverse(variableIndex)(1:𝔹,3,0)),measure(reverse(variableIndex)(1:𝔹,2,1)),measure(reverse(variableIndex)(1:𝔹,2,2)),measure(reverse(inLoop)(1:𝔹,1,2)),measure(reverse(inLoop)(1:𝔹,2,1)),measure(reverse(inLoop)(1:𝔹,1,1)));
	assert(s==(0,1,0,1,1,1,0,1));
	return (r,s);
}
