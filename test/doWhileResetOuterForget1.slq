// args: --run

def fail():⊥{ assert(false); }
def outerClassical(){
	n:=1;
	x:=vector(n,0:!𝔹);
	k:=0;
	do{ k+=1; }while k<3 { n+=1; }
	return n;
}
def outerInteger(){
	c:=2;
	x:=0:uint[c];
	k:=0;
	do{ k+=1; }while k<2 { c+=1; }
	return c;
}
def abortingBranch(const b:!𝔹){
	n:=1;
	x:=vector(n,0:𝔹);
	k:=0;
	do{ k+=1; }while k<2 {
		if b { assert(false); } else { n+=1; }
	}
	return n;
}
def oneBranch(m:!ℕ){
	c:=1;
	v:=vector(c,0:𝔹);
	k:=0;
	do{ k+=1; }while k<3 {
		if k==m { c+=1; }
	}
	return c;
}
def abortingCallBranch(m:!ℕ){
	c:=1;
	v:=vector(c,0:𝔹);
	k:=0;
	do{ k+=1; }while k<3 {
		c+=1;
		if k==m { fail(); }
	}
	return c;
}
def abortingCallOtherBranch(m:!ℕ){
	c:=1;
	v:=vector(c,0:𝔹);
	k:=0;
	do{ k+=1; }while k<3 {
		if k==m { fail(); } else { c+=1; }
	}
	return c;
}
def returningBranch(m:!ℕ){
	c:=1;
	v:=vector(c,0:𝔹);
	k:=0;
	do{ k+=1; }while k<3 {
		c+=1;
		if k==m { return c; }
	}
	return c+10;
}
def forInReset(){
	c:=1;
	v:=vector(c,0:𝔹);
	k:=0;
	do{ k+=1; }while k<2 {
		for i in 0..2 { c+=1; }
	}
	return c;
}
def quantumDependency(){
	c:=1;
	q:=H(0:𝔹);
	v:=vector(c,dup(q));
	k:=0;
	do{ k+=1; }while k<2 { c+=1; }
	return (c,measure(H(q)));
}
def main(){
	r:=(outerClassical(),outerInteger(),abortingBranch(false),oneBranch(2),oneBranch(5),abortingCallBranch(5),abortingCallOtherBranch(5),returningBranch(2),returningBranch(5),forInReset(),quantumDependency());
	assert(r==(3,3,2,2,1,3,3,3,13,3,(2,0)));
	return r;
}
