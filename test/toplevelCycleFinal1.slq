// args: --run

def f0(n:!ℕ){
	if n==0 { return 1; }
	r:=0:!ℤ;
	for i in [0..1){ r=x0[0](n sub 1)-2; }
	return r;
}
def f2(n:!ℕ){
	if n==0 { return 1; }
	return x0[0](n sub 1)+2;
}
def f1(n:!ℕ){
	if n==0 { return 0; }
	return f2(n sub 1)·1;
}
x1:=f1;
x0:=(f0,f1);
def main(){
	assert(x1(4)==-1);
	return (x1(3),x1(4),x0[0](3));
}
