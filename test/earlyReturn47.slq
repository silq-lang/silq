// args: --run

def f(b:!ℕ):!ℕ{
	def go(n:!ℕ):!ℕ{
		r:=0;
		for i in 0..2 {
			if r>1 { return r; }
			r=(if n>0 then go(n sub 1) else 1);
		}
		mk:=λ(k:!ℕ)⇒k;
		return mk(r);
	}
	return go(b);
}
def g(b:!ℕ):!ℕ{
	def go(n:!ℕ):!ℕ{
		r:=0;
		for i in 0..3 {
			if r>1 { return r; }
			r+=(if n>0 then go(n sub 1) else 1);
		}
		def mk(k:!ℕ)⇒λ(x:!ℕ)⇒x+k;
		return mk(r)(0);
	}
	return go(b);
}
def main(){
	assert(f(2)==1);
	assert(g(0)==2);
	assert(g(2)==2);
}
