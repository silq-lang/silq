// args: --remove-loops --run

def foo(const a:𝔹,const b:𝔹,n:!ℕ){
	c:=dup(a);
	e:=dup(b);
	d:=0:𝔹;
	f:=0:𝔹;
	for i in [0..n){
		j:=i%3;
		if j==0 {
			(c,d):=(X(c),H(d));
		}else if j==1 {
			t:=dup(c);
			e⊕=t;
			f:=H(f);
			forget(t);
		}else{
			if e { f:=H(f); }
		}
		if c&&e { d:=X(d); }
	}
	return (d,f);
}
def main(){
	a:=H(0:𝔹);
	b:=H(0:𝔹);
	r:=foo(a,b,5);
	return (a,b,r);
}
