// args: --run

def twice(){
	def f[moved x:𝔹]mfree ⇒ x;
	f[x]:=f[H(0:𝔹)];
	f[y]:=f[H(x)];
	return measure(y);
}
def otherMoved(){
	f:=λ[moved x:𝔹]mfree ⇒ x;
	g:=f;
	f[x]:=move(g)[H(0:𝔹)];
	return measure(H(x));
}
def parameter(f:!Π[moved x:𝔹]mfree. 𝔹){
	f[x]:=f[H(0:𝔹)];
	return measure(H(x));
}
def constParameter(const f:!Π[moved x:𝔹]mfree. 𝔹){
	f[x]:=f[H(1:𝔹)];
	return measure(H(x));
}
def captured(){
	def f[moved x:𝔹]mfree ⇒ x;
	g:=λ()mfree{ f[x]:=f[H(0:𝔹)]; return x; };
	return measure(H(g()));
}
def inBranch(c:!𝔹){
	f:=λ[moved x:𝔹]mfree ⇒ x;
	if c { f[x]:=f[H(1:𝔹)]; } else { x:=H(0:𝔹); }
	return measure(H(x));
}
def annotated(){
	def f[moved x:𝔹]mfree ⇒ x;
	f[x]:𝔹:=f[H(0:𝔹)];
	return measure(H(x));
}
def inTuple(){
	f:=λ[moved x:𝔹]mfree ⇒ x;
	(f[x],y):=(f[H(0:𝔹)],H(1:𝔹));
	return (measure(H(x)),measure(H(y)));
}
def main(){
	r:=(twice(),otherMoved(),parameter(λ[moved x:𝔹]mfree ⇒ x),constParameter(λ[moved x:𝔹]mfree ⇒ x),captured(),inBranch(true),inBranch(false),annotated(),inTuple());
	assert(r==(0,0,0,1,0,1,0,0,(0,1)));
	return r;
}
