// args: --remove-loops --run

def two(x:𝔹)qfree{
	t:=dup(x);
	return (X(x),t);
}
def foo(const a:𝔹){
	c:=dup(a);
	e:=0:𝔹;
	d:=0:𝔹;
	for i in [0..3){
		if a {
			(e,t):=two(e); /// TODO
			for j in [0..2){
				c⊕=t; /// TODO
				if c { d:=H(d); }
			}
			forget(t);
		}
	}
	return d;
}
def main(){
	a:=H(0:𝔹);
	r:=foo(a);
	return (a,r);
}
