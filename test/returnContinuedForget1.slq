// args: --run

def f(const c:!𝔹,const k:!ℕ,x:𝔹,y:𝔹){
	n:=k+1;
	if c {
		t:=dup(x);
		if k==0 { return (x,y,n); }
		y⊕=t;
		if k==1 { return (x,y,n+1); }
		u:=dup(y);
		if k==2 { return (x,y,n+2); }
		y:=X(y);
		n+=measure(H(u))&0;
	}
	return (x,y,n);
}
def main(){
	r:=(measure(f(true,0,1:𝔹,0:𝔹)),measure(f(true,1,1:𝔹,0:𝔹)),measure(f(true,2,1:𝔹,0:𝔹)),measure(f(true,3,1:𝔹,0:𝔹)),measure(f(false,3,1:𝔹,0:𝔹)));
	assert(r==((1,0,1),(1,1,3),(1,1,5),(1,0,4),(1,0,4)));
	return r;
}
