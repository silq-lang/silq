// args: --run

def inBranch(xs:𝔹^4,const c:!𝔹,const j:!ℕ)mfree{
	with { u:=1; } do { v:=j; xs[1]:=X(xs[1]); w:=1; if c { v+=1; w+=1; } }
	xs[v%4]:=X(xs[v%4]);
	return xs;
}

def quantumLast(xs:𝔹^4,const c:!𝔹,const j:!ℕ)mfree{
	with { u:=1; } do { v:=j; w:=1; if c { v+=1; w+=1; } xs[1]:=X(xs[1]); }
	xs[v%4]:=X(xs[v%4]);
	return xs;
}

def bothBranches(xs:𝔹^4,const c:!𝔹,const j:!ℕ)mfree{
	with { u:=1; } do { v:=j; xs[1]:=X(xs[1]); w:=1; if c { v+=1; w+=1; } else { v+=2; } }
	xs[v%4]:=X(xs[v%4]);
	return xs;
}

def otherOrder(xs:𝔹^4,const c:!𝔹,const j:!ℕ)mfree{
	with { u:=1; } do { v:=j; xs[1]:=X(xs[1]); w:=1; if c { w+=1; v+=1; } }
	xs[v%4]:=X(xs[v%4]);
	return xs;
}

def readsLocal(xs:𝔹^4,const c:!𝔹,const j:!ℕ)mfree{
	with { u:=1; } do { v:=j; xs[1]:=X(xs[1]); w:=1; if c { v+=w; w+=1; } }
	xs[v%4]:=X(xs[v%4]);
	return xs;
}

def forgottenLocal(xs:𝔹^4,const c:!𝔹,const j:!ℕ)mfree{
	with { u:=1; } do { v:=j; xs[1]:=X(xs[1]); w:=1; if c { v+=1; w+=1; } forget(w); }
	xs[v%4]:=X(xs[v%4]);
	return xs;
}

def quantumAfterForget(xs:𝔹^4,const c:!𝔹,const j:!ℕ)mfree{
	with { u:=1; } do { v:=j; xs[1]:=X(xs[1]); w:=1; if c { v+=1; w+=1; } forget(w); xs[2]:=X(xs[2]); }
	xs[v%4]:=X(xs[v%4]);
	return xs;
}

def localReadAfter(xs:𝔹^4,const c:!𝔹,const j:!ℕ)mfree{
	with { u:=1; } do { v:=j; xs[1]:=X(xs[1]); w:=1; if c { v+=1; w+=1; } xs[w%4]:=X(xs[w%4]); }
	xs[v%4]:=X(xs[v%4]);
	return xs;
}

def quantumInBranch(xs:𝔹^4,const c:!𝔹,const j:!ℕ)mfree{
	with { u:=1; } do { v:=j; w:=1; if c { v+=1; w+=1; xs[v%4]:=X(xs[v%4]); } }
	xs[v%4]:=X(xs[v%4]);
	return xs;
}

def localReadInBranch(xs:𝔹^4,const c:!𝔹,const j:!ℕ)mfree{
	with { u:=1; } do { v:=j; w:=1; if c { v+=1; w+=1; xs[w%4]:=X(xs[w%4]); } }
	xs[v%4]:=X(xs[v%4]);
	return xs;
}

def inLoop(xs:𝔹^4,const c:!𝔹,const j:!ℕ)mfree{
	with { u:=1; } do { v:=j; xs[1]:=X(xs[1]); w:=1; for i in 0..2 { v+=1; w+=1; } }
	xs[v%4]:=X(xs[v%4]);
	return xs;
}

def fromTransformation(xs:𝔹^4,const c:!𝔹,const j:!ℕ)mfree{
	with { u:=1; } do { v:=j+u; xs[1]:=X(xs[1]); w:=u; if c { v+=1; w+=1; } }
	xs[v%4]:=X(xs[v%4]);
	return xs;
}

def forgottenAfter(xs:𝔹^4,const c:!𝔹,const j:!ℕ)mfree{
	with { u:=1; } do { v:=j; xs[1]:=X(xs[1]); w:=1; if c { v+=1; w+=1; } }
	xs[v%4]:=X(xs[v%4]);
	forget(v);
	return xs;
}

def inOuterBranch(xs:𝔹^4,const c:!𝔹,const j:!ℕ)mfree{
	if c {
		with { u:=1; } do { v:=j; xs[1]:=X(xs[1]); w:=1; if c { v+=1; w+=1; } }
		xs[v%4]:=X(xs[v%4]);
	}
	return xs;
}

