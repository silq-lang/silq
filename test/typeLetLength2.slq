// args: --run

def g1(b:!ℕ)⇒vector(let{ f:=λ(x:!ℕ)⇒x+b; } in f(b),false);
def g2(b:!ℕ)⇒vector(let{ def go(n:!ℕ):!ℕ{ r:=0; for i in 0..2 { f:=λ(x:!ℕ)⇒x+b; r=f(r); } return r; } } in go(b),false);
def g3(b:!ℕ)⇒vector(let{ def go(n:!ℕ):!ℕ{ def h(m:!ℕ)⇒m+n; return 1; } } in go(b),false);
def g4(b:!ℕ)⇒vector(let{ def go(n:!ℕ):!ℕ{ def rec(i:!ℕ,r:!ℕ):!ℕ{ if i==0 { return r; } return rec(i sub 1,(if n>0 then go(n sub 1) else 1)); } return rec(2,0); } } in go(b),false);
def g5(b:!ℕ)⇒vector(let{ def go(n:!ℕ):!ℕ{ r:=2; def step(r:!ℕ):!ℕ{ f:=λ(x:!ℕ)⇒x+r; r=f(r); h:=λ(x:!ℕ)⇒x+r; r=h(r); return r; } return step(r); } } in go(b),false);
def g6(b:!ℕ)⇒vector(let{ def go(n:!ℕ):!ℕ{ r:=0; r+=(let{ u:=n; } in u); return r; } } in go(b),false);
def g7(b:!ℕ)⇒vector(let{ def go(n:!ℕ):!ℕ{ r:=0; for i in 0..2 { r+=n; if r>2 {} else { for j in 0..2 { r+=1; } } } return r; } } in go(b),false);
def g8(b:!ℕ)⇒vector(let{ def go(n:!ℕ):!ℕ{ r:=1; for i in 0..1 { f:=λ(x:!ℕ)⇒x+r; r=f(r); h:=λ(x:!ℕ)⇒x+r; r=h(r); } return r; } } in go(b),false);
def main(){
	v1:=g1(2); assert(v1.length==4);
	v2:=g2(2); assert(v2.length==4);
	v3:=g3(2); assert(v3.length==1);
	v4:=g4(2); assert(v4.length==1);
	v5:=g5(2); assert(v5.length==8);
	v6:=g6(2); assert(v6.length==2);
	v7:=g7(2); assert(v7.length==6);
	v8:=g8(2); assert(v8.length==4);
}
