// args: --remove-loops --run

def f(c:!ℕ){
	a:=H(0:𝔹);
	x:=dup(a); y:=0:𝔹;
	if c==0 {
		repeat 3 { x:=X(x); y⊕=x; }
	} else {
		a:=H(a);
	}
	return (a,x,y);
}
def main(){
	(a0,x0,y0):=f(0);
	y0⊕=x0;
	x0⊕=a0;
	assert(measure(x0,y0)==(1,1));
	(a1,x1,y1):=f(1);
	assert(measure(y1)==0);
	return (a0,a1,x1);
}
