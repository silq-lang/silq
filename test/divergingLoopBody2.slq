// args: --run

def w(n:!ℕ){
	c:=1;
	v:=vector(c,0:𝔹);
	k:=0;
	while k<n { k+=1; measure(v); c+=1; v:=vector(c,1:𝔹); assert(false); }
	return (c,measure(v):!𝔹[]);
}
def f(n:!ℕ){
	c:=1;
	v:=vector(c,0:𝔹);
	for i in [0..n) { measure(v); c+=i; assert(false); }
	return (c,measure(v):!𝔹[]);
}
def g(n:!ℕ){
	c:=1;
	v:=vector(c,0:𝔹);
	for i in (n..-1..0] { measure(v); c+=i; v:=vector(c,1:𝔹); assert(false); }
	return (c,measure(v):!𝔹[]);
}
def r(n:!ℕ){
	c:=1;
	v:=vector(c,0:𝔹);
	repeat n { measure(v); c+=1; v:=(vector(c,1:𝔹),)[1]; }
	return (c,measure(v):!𝔹[]);
}
def main(){
	return (w(0),f(0),g(0),r(0));
}
