// args: --run

def generic(b:!𝔹){
	c:=0;
	c+=1;
	v:=vector(c,0:𝔹);
	if b { measure(v); c=3; } else { measure(v); }
	return c;
}
def copied(b:!𝔹){
	c:=0;
	c+=1;
	v:=vector(c,0:𝔹);
	if b { measure(v); c=3; } else { w:=v; measure(w); }
	return c;
}
def forgotten(b:!𝔹){
	c:=0;
	c+=1;
	v:=vector(c,0:𝔹);
	if b { measure(v); c=3; } else { forget(v=vector(c,0:𝔹)); }
	return c;
}
def forgottenBeforeSplit(b:!𝔹){
	c:=0;
	c+=1;
	v:=vector(c,0:𝔹);
	if b { forget(v=vector(c,0:𝔹)); x:=[c]; } else { forget(v); x:=[c]; }
	c:=2;
	return (x[0],c);
}
def mergedMeasured(b:!𝔹){
	c:=1;
	if b { c=2; v:=vector(c,0:𝔹); } else { v:=vector(c,0:𝔹); }
	if b { measure(v); c=3; } else { measure(v); }
	return c;
}
def mergedForgotten(b:!𝔹){
	c:=1;
	if b { c=2; v:=vector(c,0:𝔹); } else { v:=vector(c,0:𝔹); }
	if b { forget(v=vector(c,0:𝔹)); c=3; } else { forget(v=vector(c,0:𝔹)); }
	return c;
}
def main(){
	r:=(generic(true),generic(false),copied(true),copied(false),forgotten(true),forgotten(false),forgottenBeforeSplit(true),forgottenBeforeSplit(false));
	assert(r==(3,1,3,1,3,1,(1,2),(1,2)));
	s:=(mergedMeasured(true),mergedMeasured(false),mergedForgotten(true),mergedForgotten(false));
	assert(s==(3,1,3,1));
	return (r,s);
}
