// args: --run

def qubits(){
	n:=2;
	q:=vector(n,0:𝔹);
	n=3;
	return (n,q);
}
def redefinedInLoop(){
	n:=1;
	do{
		v:=vector(n,0:𝔹);
		n+=1;
	}while n<3;
	return measure(v);
}
def forgottenInBranch(b:!𝔹){
	n:=2;
	x:=H(0:𝔹);
	q:=vector(n,dup(x));
	n+=1;
	if b { forget(q); }
	return (n,measure(H(x)));
}
def consumedAfterLoop(){
	c:=1;
	v:=vector(c,1:𝔹);
	k:=0;
	while k<2 { k+=1; c+=1; }
	return (c,measure(v));
}
def forgottenInReset(){
	c:=1;
	x:=H(0:𝔹);
	v:=vector(c,dup(x));
	k:=0;
	do{ k+=1; }while k<2 { c+=1; }
	return (c,measure(H(x)));
}
def main(){
	(n,q):=qubits();
	r:=(n,measure(q),redefinedInLoop(),forgottenInBranch(true),forgottenInBranch(false),consumedAfterLoop(),forgottenInReset());
	assert(r==(3,(0,0),(0,0),(3,0),(3,0),(3,(1,)),(2,0)));
	return r;
}
