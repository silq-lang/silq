// args: --run

def tupleSuffix(){
	t:=(1,true,3);
	return t[1..3];
}
def tupleWhole(){
	t:=(1,2);
	return t[0..2];
}
def emptyArraySlice():𝔹[]{
	x:=[]:𝔹[];
	return x[0..x.length];
}
def bottomArraySlice():𝔹[]{
	x:=[]:⊥[];
	return x[0..x.length];
}
def main(){
	(a,b):=tupleSuffix();
	(c,d):=tupleWhole();
	e:=emptyArraySlice();
	f:=bottomArraySlice();
	assert(a&&b==3&&c==1&&d==2&&e.length==0&&f.length==0);
	return (a,b,c,d,e,f);
}
