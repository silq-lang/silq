// args: --run

def f(){
	x:=vector(2,0:𝔹);
	k:=0;
	do{ n:=2; b:=𝔹^n; a:=b; x:=x coerce a; k+=1; }while k<3;
	return measure(x);
}
def g(m:!ℕ){
	x:=vector(m,0:𝔹);
	k:=0;
	do{ n:=dup(m); b:=𝔹^n; a:=b; x:=x coerce a; x[0]:=X(x[0]); k+=1; }while k<3;
	return measure(x);
}
def h(){
	c:=1:𝔹;
	x:=vector(2,0:𝔹);
	k:=0;
	do{ n:=2+0; b:=𝔹^n; a:=b; x:=x coerce a; if c { x[1]:=X(x[1]); } measure(0:𝔹); k+=1; }while k<3;
	return (measure(x),measure(c));
}
def main(){
	r:=(f(),g(2),h());
	assert(r==((0,0),(1,0),((0,1),1)));
	return r;
}
