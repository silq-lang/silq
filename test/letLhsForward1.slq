// args: --run

def main(){
	(let { a:=_; } in a):=1;
	(let { b:=(y,z); } in b):=(2,3);
	(w,(let { c:=_; } in c)):=(4,5);
	(let { d:=(_,v); } in d):=(6,7);
	(let { e:=v; } in e)+=1;
	x:=vector(2,0:𝔹);
	(let { f:=x[1]; } in f)⊕=1;
	q:=H(0:𝔹);
	(let { g:=u; } in g):=dup(q);
	forget(u=dup(q));
	assert((y,z,w,v)==(2,3,4,8)&&measure(x)==(0,1));
	return measure(H(q));
}
