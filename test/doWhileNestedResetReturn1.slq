// args: --run

def f(const c:!𝔹){
	x:=vector(2,1:𝔹);
	k:=0;
	do{ k+=1; }while k<2 {
		j:=0;
		do{
			j+=1;
			y:=vector(1,0:𝔹);
			n:=x.length;
			x:=x coerce 𝔹^n;
		}while j<1 {
			return (0,[]:!𝔹[]);
		}
	}
	return (k,measure(x:𝔹[]));
}

def g(const c:!𝔹){
	x:=vector(2,1:𝔹);
	k:=0;
	do{ k+=1; }while k<2 {
		j:=0;
		do{
			j+=1;
			n:=x.length;
			x:=x coerce 𝔹^n;
		}while j<2 {
			if c { return (j,[]:!𝔹[]); }
		}
	}
	return (k,measure(x:𝔹[]));
}

def main(){
	assert(f(true)==(2,[1,1]));
	assert(g(true)==(1,[])&&g(false)==(2,[1,1]));
}
