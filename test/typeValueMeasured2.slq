def localInReturnType(){
	t:=uint[measure(H(0)) as !ℕ];
	x:=1:t;
	return x; /// error
}
def valueInReturnType(){
	t:=uint[1+measure(H(0)) as !ℕ];
	x:=1:t;
	return x+x; /// error
}
def twoEvaluations(){
	t:=uint[1+measure(H(0)) as !ℕ];
	s:=uint[1+measure(H(0)) as !ℕ];
	x:=1:t;
	y:=1:s;
	z:=x+y; /// error
	return measure(z) as !ℕ;
}
def measuredType(q:𝔹){
	return uint[1+measure(q) as !ℕ];
}
def opaque(){
	t:=measuredType(H(0));
	x:=1:t; /// error
	return measure(x) as !ℕ;
}
def increment[n:!ℕ](x:uint[n]){
	x+=1;
	return x;
}
def inferredLength(){
	t:=uint[measure(H(0))+1];
	return increment(0:t); /// error
}
def main(){ }
