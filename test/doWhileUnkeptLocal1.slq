// args: --run

def bodyConsumes(n:!ℕ){
	q:=H(H(0:𝔹));
	k:=0;
	do{ k+=1; t:=dup(q); q:=X(q); }while k<n;
	return measure(q);
}
def resetConsumes(n:!ℕ){
	q:=H(H(0:𝔹));
	k:=0;
	do{ k+=1; t:=dup(q); }while k<n{ q:=X(q); }
	return measure(q);
}
def resetBranchConsumes(n:!ℕ){
	q:=H(H(0:𝔹));
	k:=0;
	do{ k+=1; t:=X(dup(q)); }while k<n{ if k<2 { q:=X(q); } }
	return measure(q);
}
def usedInBody(n:!ℕ){
	q:=H(H(0:𝔹));
	r:=0;
	k:=0;
	do{ k+=1; t:=X(dup(q)); r+=measure(t); q:=X(q); }while k<n;
	return (r,measure(q));
}
def keptAtExit(n:!ℕ){
	q:=H(H(0:𝔹));
	k:=0;
	do{ k+=1; t:=X(dup(q)); }while k<n;
	return (measure(t),measure(q));
}
def main(){
	r:=(bodyConsumes(1),bodyConsumes(2),resetConsumes(2),resetBranchConsumes(3),usedInBody(3),keptAtExit(2));
	assert(r==(1,0,1,1,(2,1),(1,0)));
	return r;
}
