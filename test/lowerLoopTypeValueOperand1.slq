// args: --run

def id[τ:*](x:!ℕ)⇒x;
def notType(N:!ℕ){
	s:=0;
	for j in 0..2 {
		k:=j+N;
		t:=!uint[move(k)];
		s+=id[t](j);
	}
	return s;
}
def arrayType(N:!ℕ){
	s:=0;
	for j in 0..3 {
		k:=j+N;
		t:=uint[move(k)][];
		s+=id[t](j);
	}
	return s;
}
def powerType(N:!ℕ){
	s:=0;
	for j in 0..2 {
		k:=j+N;
		t:=uint[move(k)]^2;
		s+=id[t](j+1);
	}
	return s;
}
def nested(N:!ℕ){
	s:=0;
	repeat 2 {
		k:=N;
		t:=(𝔹^(move(k)))[];
		s+=id[t](2);
	}
	return s;
}
def closure(N:!ℕ){
	s:=0;
	i:=0;
	while i<2 {
		k:=i+N;
		t:=!uint[(λ(){ return move(k); })()];
		s+=id[t](3);
		i+=1;
	}
	return s;
}
def letArg(N:!ℕ){
	s:=0;
	for j in 0..2 {
		k:=j+N;
		t:=uint[let { m:=move(k); } in m][];
		s+=id[t](j);
	}
	return s;
}
def main(){
	r:=(notType(1),arrayType(2),powerType(1),nested(2),closure(1),letArg(1));
	assert(r==(1,3,3,4,6,1));
	return r;
}
