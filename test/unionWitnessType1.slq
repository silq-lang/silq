// args: --run

def maximum(){
	x:=vector(2,0):⋃[n:!ℕ]. !ℕ^(n+1);
	return max(x);
}
def lengths(){
	x:=vector(2,1:!ℕ):⋃[n:!ℕ]. !ℕ^(n+1);
	y:=vector(1,1:!ℕ):⋃[n:!ℕ]. !ℕ^(n+1);
	return x.length+y.length;
}
def booleanDomain(b:!𝔹):⋃[n:!𝔹]. !ℕ^(n+1)⇒vector(b+1,3:!ℕ);
def widened(b:!𝔹){
	x:=booleanDomain(b):⋃[n:!ℕ]. !ℕ^(n+1);
	return x.length+1;
}
def main(){
	r:=(maximum(),lengths(),widened(0),widened(1));
	assert(r==(0,3,2,3));
	return r;
}
