// args: --run

def f(const c:!𝔹){
	if c {
		repeat 1 { if c { n:=1; } else { return 0; } x:=vector(n,1:𝔹); }
		return 0;
	} else {
		x:=vector(1,0:𝔹);
		measure(x);
	}
	x:=vector(0,0:𝔹);
	n:=x.length; x:=x coerce 𝔹^n;
	return measure(x:𝔹[]).length;
}
def g(const c:!𝔹){
	if c {
		for i in 0..1 { if c { n:=1; } else { return 0; } x:=vector(n,1:𝔹); }
		return 0;
	} else {
		x:=vector(1,0:𝔹);
		measure(x);
	}
	x:=vector(0,0:𝔹);
	return measure(x:𝔹[]).length;
}
def h(const c:!𝔹){
	if c {
		k:=0;
		while k<1 { k+=1; if c { n:=1; } else { return 0; } x:=vector(n,1:𝔹); }
		return 0;
	} else {
		x:=vector(1,0:𝔹);
		measure(x);
	}
	x:=vector(2,0:𝔹);
	return measure(x:𝔹[]).length;
}
def k(const c:!𝔹){
	if c {
		do{ if c { n:=1; } else { return 0; } x:=vector(n,1:𝔹); }while false;
		return 0;
	} else {
		x:=vector(1,0:𝔹);
		measure(x);
	}
	x:=vector(2,0:𝔹);
	return measure(x:𝔹[]).length;
}
def p(const c:!𝔹){
	if c {
		repeat 1 { if c { n:=1; } else { return 0; } x:=vector(n,1:𝔹); }
		return 0;
	} else {
		y:=vector(1,0:𝔹);
		measure(y);
	}
	y:=vector(0,0:𝔹);
	return measure(y:𝔹[]).length;
}
def main(){
	assert(f(true)==0&&f(false)==0);
	assert(g(true)==0&&g(false)==0);
	assert(h(true)==0&&h(false)==2);
	assert(k(true)==0&&k(false)==2);
	assert(p(true)==0&&p(false)==0);
}
