// args: --run

def g(x:!ℕ)⇒x==1;

def f(c:!𝔹,x:!ℕ){
	r:=c||g(move(x));
	return r;
}
def h(c:!𝔹,x:!ℕ){
	r:=c&&(let{ t:=move(x); } in t)==1;
	return r;
}
def k(c:!𝔹,y:𝔹){
	x:=dup(y);
	r:=c&&(dup(move(x))==1);
	return (r,y);
}
def l(c:!𝔹,y:𝔹){
	x:=dup(y);
	r:=c||measure(x);
	return (r,y);
}

def main(){
	assert(f(false,1)&&f(true,0)&&!f(false,0));
	assert(h(true,1)&&!h(false,1)&&!h(true,0));
	assert(measure(k(true,1:𝔹))==(1,1)&&measure(k(false,1:𝔹))==(0,1));
	(r,y):=l(false,1:𝔹);
	(s,z):=l(true,0:𝔹);
	m:=measure(y,z);
	assert(r&&s&&m==(1,0));
}
