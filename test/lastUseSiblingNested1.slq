// args: --run

def f(c:!ℕ){
	a:=H(0:𝔹);
	x:=dup(a); y:=0:𝔹;
	if c==0 {
		if true { t:=dup(x); x:=X(x); y⊕=t; }
	} else {
		a:=H(a);
	}
	return (a,x,y);
}
def g(c:!ℕ){
	a:=H(0:𝔹);
	x:=dup(a); y:=0:𝔹;
	if c<2 {
		if c==0 { t:=dup(x); x:=X(x); y⊕=t; }
	} else {
		a:=H(a);
	}
	return (a,x,y);
}
def h(c:!ℕ){
	a:=H(0:𝔹);
	x:=dup(a); y:=0:𝔹;
	if c==0 {
		if true { t:=dup(x); x:=X(x); y⊕=t; }
		a:=H(a);
	}
	return (a,x,y);
}

def main()⇒[measure(f(i),g(i),h(i)) for i in 0..5];
