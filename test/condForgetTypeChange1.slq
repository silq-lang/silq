// args: --run

def main(){
	a:=(1,0,1):𝔹×!𝔹×!𝔹;
	if (if measure(H(0)) then a[0] else a[2]) { a[1]:=X(a[1]); }
	assert(measure(a)==(1,1,1));
	b:=(λ()⇒vector(3,1:𝔹))();
	b[0]:=H(b[0]);
	if if measure(H(0)) then (if measure(H(0)) then b[0] else b[2]) else b[2] { b[1]:=X(b[1]); }
	return measure(b);
}
