
def foo[n:!ℕ](xs:𝔹^n,t:!ℕ)⇒xs;
def bar[k:!ℕ](xs:𝔹^k,t:!ℕ)⇒xs;
def baz[k:!ℕ](const xs:𝔹^k,t:!ℕ)⇒t;

def reversed(){
	n:=2;
	x:=reverse(reverse(foo))(vector(n,0),let forget(n) in 2); /// error
}
def renamed(){
	n:=2;
	x:=bar(vector(n,0),let forget(n) in 2); /// error
}
def generic(){
	n:=2;
	l:=λ[k:!ℕ](xs:𝔹^k,t:!ℕ)⇒xs;
	x:=l(vector(n,0),let forget(n) in 2); /// error
}
def classicalResult(){
	n:=2;
	x:=baz(vector(n,0),let forget(n) in 2); /// error
	return x;
}
