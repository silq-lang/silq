// args: --run

def f(n:!ℕ){
	x:=1;
	k:=0;
	do{ x+=1; k+=1; }while k<n{ x=0:!𝔹; }
	return x;
}
def g(c:!𝔹){
	x:=1;
	do{ x+=1; }while c{ assert(false); }
	return x;
}
def h(c:!𝔹){
	x:=1;
	do{ x+=1; }while c{ y:=(x,)[1]; }
	return x;
}
def main(){
	r:=(f(1),f(3),g(false),h(false));
	assert(r==(2,1,2,2));
	return r;
}
