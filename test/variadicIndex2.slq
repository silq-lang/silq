// args: --run

def f[τ:*[]](const xs:∏ τ,const i:!ℕ)⇒dup(xs[i]);
def m[τ:*[]](const xs:∏ τ)⇒measure(dup(xs[1])); // (classical element type `!τ[1]`)
def g[n:!ℕ][τ:*^n](const xs:∏ τ)⇒measure(dup(xs[0]));
def c[τ:*[]](xs:!∏ τ)⇒xs[1];
def main(){
	a:=f[[!ℕ,𝔹]]((3,1:𝔹),1);
	b:=f[[!ℕ,𝔹]]((3,1:𝔹),0);
	r:=(measure(a),b,m[[!ℕ,𝔹,uint[2]]](3,1:𝔹,2:uint[2]),g[2][(uint[2],𝔹)](3:uint[2],0:𝔹),c[[𝔹,𝔹]](0:!𝔹,1:!𝔹));
	assert(r=(1,3,1,3,1));
	return r;
}
