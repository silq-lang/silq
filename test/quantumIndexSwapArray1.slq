// args: --run

def f()⇒[0,1]:!𝔹[];
def main(){
	x:=f();
	y:=H(0);
	z:=H(0);
	(i,j):=dup(y,z);
	(x[i],x[j]):=(x[j],x[i]);
	assert(measure(x=if y==z then [0,1] else [1,0]));
	u:=([0,1]:!𝔹[],[1,1]:!𝔹[]);
	k:=dup(y);
	(u[0][k],u[0][0]):=(u[0][0],u[0][k]);
	assert(measure(u[0]=if y then [1,0] else [0,1]));
	return (x,y,z,i,j,u,k);
}
