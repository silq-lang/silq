// args: --compile
// loops whose bodies replace a component of an aggregate under a condition on another component

def f(){
	x:=(H(0:𝔹),0:𝔹);
	repeat 3 {
		if x[0] {
			x[1]:=X(x[1]);
		}
	}
	return x;
}
def g(){
	x:=(H(0:𝔹),0:𝔹);
	repeat 2 {
		repeat 2 {
			if x[0] {
				x[1]:=X(x[1]);
			}
		}
	}
	return x;
}
def main()⇒(f(),g());
