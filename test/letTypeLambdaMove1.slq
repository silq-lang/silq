// args: --run

def foo(n:!ℕ) ⇒ vector(let { def f(x: !ℕ):!ℕ ⇒ (λ()⇒move(x))()+n; x:=f(0); } in x, false);
def bar(n:!ℕ) ⇒ vector(let { def f(x: !ℕ):!ℕ { y:=x+1; return (λ()⇒move(y))()+n; } x:=f(0); } in x, true);
def baz(n:!ℕ) ⇒ vector(let { def f(x: !ℕ):!ℕ ⇒ (λ()⇒(λ()⇒move(x))())()+n; x:=f(1); } in x, false);

def main(){
	q:=H(0);
	m:=measure(q);
	y:=foo(m);
	forget(y=vector(m,false));
	z:=bar(m);
	forget(z=vector(m+1,true));
	w:=baz(m);
	forget(w=vector(m+1,false));
}
