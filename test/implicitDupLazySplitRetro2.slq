// args: --run

def laterUse(a:𝔹,k:!𝔹){
	ms:=0:!ℕ;
	v0:=dup(a);
	v1:=dup(v0);
	ms+=measure(v1);
	if k { a:=X(a); t:=measure(v1); ms+=2*t; t2:=measure(v0); ms+=4*t2; }
	else { a:=X(a); t:=measure(v0); ms+=8*t; }
	return (a,ms);
}
def usedBeforeConsumption(a:𝔹,k:!𝔹){
	ms:=0:!ℕ;
	v0:=dup(a);
	v1:=!v0;
	ms+=measure(v1);
	if k { u:=!v0; forget(u); t:=measure(v1); ms+=2*t; a:=X(a); }
	else { a:=X(a); t:=measure(v0); ms+=4*t; }
	return (a,ms);
}
def nestedConsumption(a:𝔹,k:!𝔹,l:!𝔹){
	ms:=0:!ℕ;
	v0:=dup(a);
	v1:=dup(v0);
	ms+=measure(v1);
	if k {
		if l { u:=!v0; forget(u); } else { t:=measure(v0); ms+=2*t; }
		t2:=measure(v1);
		ms+=4*t2;
		a:=X(a);
	} else { t:=measure(v0); ms+=8*t; a:=X(a); }
	return (a,ms);
}
def main(){
	(a0,m0):=laterUse(1:𝔹,true); (a1,m1):=laterUse(1:𝔹,false);
	(a2,m2):=usedBeforeConsumption(0:𝔹,true); (a3,m3):=usedBeforeConsumption(1:𝔹,false);
	(a4,m4):=nestedConsumption(1:𝔹,true,true); (a5,m5):=nestedConsumption(1:𝔹,true,false); (a6,m6):=nestedConsumption(1:𝔹,false,false);
	r:=((measure(a0),m0),(measure(a1),m1),(measure(a2),m2),(measure(a3),m3),(measure(a4),m4),(measure(a5),m5),(measure(a6),m6));
	assert(r==((0,7),(0,9),(1,3),(0,4),(0,5),(0,7),(0,9)));
	return r;
}
