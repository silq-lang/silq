// args: --run

def f(xs:𝔹^4,const j:!ℕ)mfree{
	k:=j+3;
	with { u:=j+j; } do {
		v0:=dup(u);
		v1:=(v0+j)%4;
		v2:=k+v0; /// TODO
		if u%4==1 { k+=2; v2+=dup(u); v1+=dup(v0); }
		xs[(j*2)%4]:=X(xs[(j*2)%4]);
	}
	return xs;
}

def main(){
	r:=(measure(reverse(f)((1,0,0,0):𝔹^4,0)),measure(reverse(f)((1,0,0,0):𝔹^4,1))); /// TODO
	assert(r==((0,0,0,0),(1,0,1,0)));
	return r;
}
