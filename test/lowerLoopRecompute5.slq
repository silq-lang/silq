// args: --remove-loops --run

def f(c1:!ℕ){
	q0:=H(0:𝔹); q1:=H(0:𝔹); a:=vector(3,0:𝔹);
	t:=dup(q1); if t { a[0]:=X(a[0]); }
	if c1==0 {
		repeat 3 { a[2]:=X(a[2]); q0:=H(q0); }
	} else {
		q1:=H(q1);
	}
	return (q0,q1,a);
}
def main(){
	(q0,q1,a):=f(0);
	m:=measure(a);
	assert(measure(q0)==0&&m[2]==1);
	return q1;
}
