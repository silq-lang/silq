// args: --remove-loops --run

def f[n:!ℕ](const xs:𝔹^n,const a:𝔹)mfree{
	for i in [0..n){
		if xs[i] { return X(0:𝔹); }
	}
	if a { return H(0:𝔹); } else { return 0:𝔹; }
}
def g[n:!ℕ](const xs:𝔹^n,const a:𝔹)mfree:𝟙{
	for i in [0..n){
		if xs[i] { return; }
	}
	b:=dup(a);
	forget(b=dup(a));
}
def main(){
	xs:=(H(0:𝔹),H(0:𝔹));
	a:=H(0:𝔹);
	r:=f(xs,a);
	g(xs,a);
	return (xs,a,r);
}
