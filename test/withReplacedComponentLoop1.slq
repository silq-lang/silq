// args: --run

def converted(){
	x:=(1:𝔹,0,0:𝔹);
	with{
		t:=x[0];
	}do{
		for i in 0..3 { x[1]:=CNOT(t,x[1]); }
	}
	return measure(x);
}
def repeated(){
	x:=(0:𝔹,1:𝔹);
	with{
		t:=x[0];
	}do{
		repeat 2 { x[1]:=CNOT(t,x[1]); }
	}
	return measure(x);
}
def entangled(){
	x:=(H(0:𝔹),0:𝔹,0);
	with{
		t:=x[0];
	}do{
		k:=0;
		while k<3 { x[1]:=CNOT(t,x[1]); x[2]:=CNOT(t,x[2]); k+=1; }
	}
	(a,b,c):=measure(x);
	assert(a==b&&a==c);
	return ();
}
def main(){
	r:=(converted(),repeated());
	assert(r==((1,1,0),(0,1)));
	entangled();
	return r;
}
