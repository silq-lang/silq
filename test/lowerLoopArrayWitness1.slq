// args: --remove-loops --run

def candidates(){
	samples:=3;
	s:=0;
	for i in 0..2{
		def prepare(φ:𝔹)mfree{
			cands:=[]:𝔹[];
			for k in 0..samples{
				x:=H(0:𝔹);
				cands~=[H(x)];
			}
			return (cands coerce 𝔹^samples,φ);
		};
		φ:=0:𝔹;
		(cands,φ):=prepare(φ);
		s+=cands.length;
		prepare(φ):=(cands,φ);
		forget(φ=0);
	}
	return s;
}
def size(b:!ℕ)⇒vector(let{ def go(n:!ℕ):!ℕ{ r:=0; if r>0 { for i in 0..2 { return r; } } return r; } } in go(b),false);
def logged(){
	x:=vector(2,0:𝔹);
	s:=0;
	repeat 2 {
		y:=measure(x);
		s+=y.length;
		x:=vector(0,1:𝔹);
	}
	return s;
}
def main(){
	r:=(candidates(),size(3).length,logged());
	assert(r==(6,0,2));
	return r;
}
