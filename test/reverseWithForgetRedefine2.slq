// args: --run

def f(xs:𝔹^4,const j:!ℕ)mfree{
	v:=j*2;
	xs[(v+1)%4]:=X(xs[(v+1)%4]);
	with { u:=1; } do { /// TODO
		with { t:=(j+j)%4; } do { forget(v); }
		v:=dup(j);
		xs[(u+2)%4]:=X(xs[(u+2)%4]);
	}
	xs[v%4]:=X(xs[v%4]);
	return xs;
}

def main(){
	r:=measure(reverse(f)((1,0,1,0):𝔹^4,1)); /// TODO
	return r;
}
