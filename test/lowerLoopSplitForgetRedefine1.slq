// args: --remove-loops --run

def f(const a:𝔹){
	c:=dup(a);
	d:=0:𝔹;
	k:=0:!ℕ;
	while k<3{
		c⊕=1;
		m:=k+1:!ℕ;
		if m==2 { d:=X(d); }
		if c&&a { return d; }
		forget(m); m:=(k+5) as !uint[2];
		if m+3==2 { d:=X(d); }
		d:=H(d);
		k+=1;
	}
	return X(d);
}
def main(){
	a:=H(0:𝔹);
	r:=f(a);
	return (a,r);
}
