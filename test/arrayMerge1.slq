// args: --run

def single(c:!𝔹):⋃[n:!ℕ]. !ℕ^(n+1){
	if c { x:=[1]:!ℕ[]; } else { x:=[1,2]:!ℕ[]; }
	return x~[3];
}
def pair(c:!𝔹):⋃[n:!ℕ,m:!ℕ]. !ℕ^(n+1)×!ℕ^(m+2){
	if c { x:=[1]:!ℕ[]; y:=[2]:!ℕ[]; } else { x:=[1,2]:!ℕ[]; y:=[]:!ℕ[]; }
	return (x~[3],y~[4,5]);
}
def same(c:!𝔹):⋃[n:!ℕ]. (!ℕ^(n+1))^2{
	if c { x:=[1]:!ℕ[]; y:=dup(x); } else { x:=[1,2]:!ℕ[]; y:=dup(x); }
	return (x~[3],y~[4]);
}
def mixed(c:!𝔹){
	if c { x:=[1]:!ℕ[]; } else { x:=vector(2,7:!ℕ); }
	return x~[0];
}
def superposed(c:!𝔹){
	if c { x:=array(1,0:𝔹); } else { x:=array(2,0:𝔹); }
	x[0]:=H(x[0]);
	x[0]:=H(x[0]);
	return x;
}
def main(){
	r:=(single(true),single(false),pair(true),pair(false),same(true),same(false),mixed(true),mixed(false),measure(superposed(true)),measure(superposed(false)));
	assert(r==((1,3),(1,2,3),((1,3),(2,4,5)),((1,2,3),(4,5)),((1,3),(1,4)),((1,2,3),(1,2,4)),(1,0),(7,7,0),(0,),(0,0)));
	return r;
}
