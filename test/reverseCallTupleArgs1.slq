// args: --run

def app2(a:𝔹,b:𝔹)⇒(a,b,0:!𝔹,1:!𝔹);
def pairs(a:𝔹,b:𝔹)mfree⇒[(a,0:!𝔹),(b,1:!𝔹)];
def h(const c:𝔹,p:𝔹×𝔹)⇒(p,0:!𝔹);
def app01(xs:𝔹^2)⇒xs~[0,1];

def f(x:𝔹,y:𝔹)mfree{ w:=app2(x,y):𝔹^4; return w; }
def g(c:𝔹,x:𝔹,y:𝔹)mfree{ w:=h(c,(x,y)):(𝔹^2)×𝔹; return (c,w); }

def main(){
	w:=(1:𝔹,0:𝔹,0:𝔹,1:𝔹);
	app2(a,b):=w;
	assert(measure(a,b)==(1,0));
	u:=[(0:𝔹,0:𝔹),(1:𝔹,1:𝔹)]:(𝔹×𝔹)[];
	pairs(c,d):=u;
	assert(measure(c,d)==(0,1));
	e:=1:𝔹;
	v:=((0:𝔹,1:𝔹),0:𝔹);
	h(e,(x,y)):=v;
	assert(measure(e,x,y)==(1,0,1));
	z:=(1:𝔹,1:𝔹,0:𝔹,1:𝔹);
	app01([s,t]):=z;
	assert(measure(s,t)==(1,1));
	q:=(H(0:𝔹),1:𝔹,0:𝔹,1:𝔹);
	(k,l):=reverse(f)(q);
	assert(measure(H(k),l)==(0,1));
	o:=((1:𝔹,0:𝔹),0:𝔹);
	(m,n,r):=reverse(g)(0:𝔹,o);
	assert(measure(m,n,r)==(0,1,0));
	p:=(0:𝔹,1:𝔹,0:𝔹,1:𝔹);
	with{ app2(i,j):=p; } do { res:=(dup(i),dup(j)); }
	assert(measure(res,p)==((0,1),(0,1,0,1)));
}
