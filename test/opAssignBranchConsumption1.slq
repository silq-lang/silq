def f(c:!ℕ){
	a:=H(0:𝔹);
	x:=dup(a); y:=0:𝔹;
	if c==0 {
		if true { t:=dup(x); x⊕=1:𝔹; y⊕=t; } /// error
	} else {
		a⊕=1:𝔹;
	}
	return (a,x,y);
}
def g(c:!ℕ){
	a:=H(0:𝔹);
	x:=dup(a); y:=0:𝔹;
	if c<2 {
		if c==0 { t:=dup(x); x⊕=1:𝔹; y⊕=t; } /// error
	} else {
		a⊕=1:𝔹;
	}
	return (a,x,y);
}
def h(c:!ℕ){
	a:=H(0:𝔹);
	x:=dup(a); y:=0:𝔹;
	if c==0 {
		if true { t:=dup(x); x⊕=1:𝔹; y⊕=t; } /// error
		a⊕=1:𝔹;
	}
	return (a,x,y);
}
def k(c:!ℕ){
	a:=0:uint[2]; a[0]:=H(a[0]);
	x:=dup(a); y:=0:uint[2];
	if c==0 {
		if true { t:=dup(x); x+=1; y+=t; } /// error
	} else {
		a-=1;
	}
	return (a,x,y);
}
