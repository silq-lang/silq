def constUseBeforeControl(w:𝔹){
	ms:=0:!ℕ;
	p:=dup(w);
	ms+=measure(p);
	u:=!p; forget(u);
	if p { w:=X(w); }
	ms+=measure(p); /// error
	return (w,ms);
}
def returned(w:𝔹){
	ms:=0:!ℕ;
	p:=!w;
	ms+=measure(p);
	u:=!p; forget(u);
	if p { w:=X(w); }
	return (w,ms,p); /// error
}
def constUseInBranch(w:𝔹,c:!𝔹){
	ms:=0:!ℕ;
	p:=dup(w);
	ms+=measure(p);
	if c { u:=!p; forget(u); }
	if p { w:=X(w); }
	ms+=measure(p); /// error
	return (w,ms);
}
def implicitDupAfterBranches(w:𝔹,j:!𝔹){
	ms:=0:!ℕ;
	p:=!w;
	if j { ms+=measure(p); } else { ms+=measure(p); u:=!p; forget(u); }
	ms+=measure(p);
	u:=!p; forget(u);
	if j { if p { w:=X(w); } }
	ms+=measure(p); /// error
	return (w,ms);
}
