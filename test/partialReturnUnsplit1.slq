// args: --run

def f(n:!ℕ,b:!ℕ):!ℕ{
	if n>2 {
		a:=vector(b,false);
		if n>3 { return 1; }
	}
	return 0;
}
def g(n:!ℕ,b:!ℕ):!ℕ{
	r:=0;
	if n>2 {
		a:=vector(b%4,1:!ℕ);
		r+=a.length;
		if r>2 { r+=1; } else { if r>0 { return r; } }
	} else {
		r+=1;
	}
	return r+b;
}
def h(n:!ℕ,b:!ℕ,q:𝔹):𝔹{
	if n>2 {
		a:=vector(b,false);
		if n>3 { return q; }
	}
	return X(q);
}
def main(){
	assert(f(2,2)==0 && f(3,2)==0 && f(4,2)==1);
	assert(g(2,2)==3 && g(3,2)==2 && g(3,3)==7);
	assert(measure(h(4,2,true)) && !measure(h(3,2,true)));
}
