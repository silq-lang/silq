// args: --run

def branch(c:!𝔹){
	n:=2;
	x:=vector(n,1:!ℕ);
	if c { n=5; }
	return (x,n);
}
def loop(){
	n:=1;
	x:=vector(n,0:!ℕ);
	for i in [0..3){ n+=1; }
	return (x,n);
}
def inner(c:!𝔹){
	n:=2;
	x:=vector(n,1:!ℕ);
	if c {
		y:=vector(n,0:!ℕ);
		if c { n=4; }
		return (x,y,n);
	}
	return (x,x,n);
}
def withBlock(){
	n:=2:!ℤ;
	x:=vector(n coerce !ℕ,1:!ℕ);
	with { n+=1; } do { y:=n; }
	return (x,y,n);
}
def redefined(m:!ℕ){
	x:=vector(m,1:!𝔹);
	m+=1;
	x:=vector(1,1:!𝔹);
	return m+x.length;
}
def main(){
	r:=(branch(true),branch(false),loop(),inner(true),inner(false),withBlock(),redefined(2));
	assert(r==(((1,1),5),((1,1),2),((0,),4),((1,1),(0,0),4),((1,1),(1,1),2),((1,1),3,2),4));
	return r;
}
