def f(){
	x:=H(0:𝔹);
	w:=H(0:𝔹);
	p:=dup(w);
	if measure(H(0:𝔹)) {
		if measure(H(0:𝔹)) { m1:=measure(p); }
		if p { w:=X(w); } /// error
