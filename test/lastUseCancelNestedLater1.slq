def g(){
	x:=H(0:𝔹);
	w:=H(0:𝔹);
	p:=dup(w);
	if measure(H(0:𝔹)) {
		if measure(H(0:𝔹)) { m1:=measure(p); }
		if measure(H(0:𝔹)) {
			m2:=measure(dup(p));
			if p { w:=X(w); } /// error
		}
	} else {
		forget(p);
		if measure(H(0:𝔹)) { return (x,w); }
	}
	return (x,w);
}
