// args: --run

def changedAfter(xs:𝔹^3,const j:!ℕ)mfree{
	with { u:=j+1; } do { v:=u+1; }
	xs[v%3]:=X(xs[v%3]);
	v+=1;
	xs[v%3]:=X(xs[v%3]);
	return xs;
}

def changedInLoop(xs:𝔹^3,const j:!ℕ)mfree{
	with { u:=j+1; } do { v:=u+1; }
	for i in 0..2 { v+=1; }
	xs[v%3]:=X(xs[v%3]);
	return xs;
}

def unusedDefinition(xs:𝔹^4,const j:!ℕ)mfree{
	with { u:=j*2; } do {
		v:=j*2;
		w:=j+j;
		xs[0]:=X(xs[0]);
	}
	xs[w%4]:=X(xs[w%4]);
	return xs;
}

def nestedMoved(xs:𝔹^4,const j:!ℕ)mfree{
	v:=j+j;
	with { u:=1; } do {
		with { t:=2; } do {
			xs[t]:=X(xs[t]);
			v+=u;
			w:=t*2;
		}
		y:=move(w);
	}
	xs[v%4]:=X(xs[v%4]);
	return xs;
}

def forgottenInBranches(xs:𝔹^4,const c:!𝔹,const j:!ℕ)mfree{
	if c { v:=j+1; w:=v+1; forget(v); } else { v:=j+2; w:=dup(v); forget(v); }
	xs[w%4]:=X(xs[w%4]);
	w+=1;
	xs[w%4]:=X(xs[w%4]);
	return xs;
}

def consumedInBranch(xs:𝔹^4,const j:!ℕ)mfree{
	k:=j+1;
	with { u:=j+1; } do { v:=u+1; if j%2==0 { xs[v%4]:=X(xs[v%4]); } else { w:=move(v); } k+=u; }
	xs[k%4]:=X(xs[k%4]);
	return xs;
}

def forgottenDeadRead(x:𝔹^3,const n:!ℕ,const c:!ℕ)qfree{
	k1:=n+c; k2:=n+c;
	(y,k1):=let { repeat 2 { k2+=1; u:=dup(k1); k1+=1; if u==2 { x[2]:=X(x[2]); } forget(u); } } in (x,k1);
	return (y,k1);
}

def changedInLetInBranch(xs:𝔹^4,j:!ℕ)mfree{
	if j%2==1 { j+=1; if j%4==2 { (xs,j):=let{ j-=1; with { a:=xs[j%4]; } do { a:=X(a); } } in (xs,j); } }
	return xs;
}

def keptBeforeBranch(xs:𝔹^4,const j:!ℕ)mfree{
	v:=j+1;
	xs[v%4]:=X(xs[v%4]);
	w:=move(v);
	if j%2==0 { w+=1; } else { v:=w+j; w+=v; }
	xs[w%4]:=X(xs[w%4]);
	return xs;
}

def keptBeforeQuantumBranch(xs:𝔹^4,const j:!ℕ)mfree{
	v:=j+1;
	xs[v%4]:=X(xs[v%4]);
	w:=move(v);
	if j%2==0 { v:=w+1; xs[v%4]:=X(xs[v%4]); w+=v; } else { xs[w%4]:=X(xs[w%4]); }
	xs[w%4]:=X(xs[w%4]);
	return xs;
}

def keptBeforeWith(xs:𝔹^4,const j:!ℕ)mfree{
	v:=j+1;
	xs[v%4]:=X(xs[v%4]);
	forget(v);
	with { u:=dup(j); } do { xs[(u+1)%4]:=X(xs[(u+1)%4]); v:=u*2; w:=move(v); }
	w+=j;
	xs[w%4]:=X(xs[w%4]);
	return xs;
}

def branchesUnread(xs:𝔹^4,const j:!ℕ)mfree{
	v:=j*2;
	xs[v%4]:=X(xs[v%4]);
	forget(v);
	if j%2==0 { v:=j+1; xs[v%4]:=X(xs[v%4]); } else { v:=dup(j); }
	return xs;
}
def selfMoveInWith(xs:𝔹^4,const j:!ℕ)mfree{
	with { u:=dup(j); } do {
		xs[(j+j)%4]:=X(xs[(j+j)%4]);
		v:=(u+j)%4;
		v:=v;
	}
	xs[(v+1)%4]:=X(xs[(v+1)%4]);
	return xs;
}
def selfMoveForgotten(xs:𝔹^4,const j:!ℕ)mfree{
	with { u:=dup(j); } do {
		xs[(j+j)%4]:=X(xs[(j+j)%4]);
		v:=(u+j)%4;
		v:=v;
	}
	forget(v);
	return xs;
}
def updatedBeforeSelfMove(xs:𝔹^4,const j:!ℕ)mfree{
	v:=3;
	for i in 0..1 {
		with { u:=dup(i); } do {
			v+=dup(j);
			(w,v):=(j*2,v);
			t:=dup(v);
		}
	}
	xs[(v+j)%4]:=X(xs[(v+j)%4]);
	return xs;
}
def conditionInWith(xs:𝔹^4,const j:!ℕ)mfree{
	with { u:=j+1; } do {
		v:=j+j;
		if v%4==0 {
			v+=dup(u);
			xs[j%4]:=X(xs[j%4]);
		}
		xs[(j*2)%4]:=X(xs[(j*2)%4]);
	}
	xs[(v+1)%4]:=X(xs[(v+1)%4]);
	return xs;
}
def redefinedInBranchWith(xs:𝔹^4,const j:!ℕ)mfree{
	v:=(j+j)%4;
	with { u:=dup(j); } do {
		w:=move(v);
		t:=u*2;
	}
	xs[t%4]:=X(xs[t%4]);
	if t%4==0 {
		for i in 0..1 { s:=j+w; }
		with { r:=2; } do { v:=t*2; }
	}
	return xs;
}
def unusedBranchDefinitions(xs:𝔹^4,const c:!𝔹,const j:!ℕ)mfree{
	v:=dup(j);
	xs[(j*2)%4]:=X(xs[(j*2)%4]);
	if v%4==1 {
		(v,w):=(v,0);
		if c { y:=move(v); } else { s:=w+v; }
	} else {
		v:=v;
	}
	return xs;
}
def movedInNestedWith(xs:𝔹^4,const j:!ℕ)mfree{
	with { u:=j+2; } do {
		with { t:=dup(u); } do { xs[(j*2)%4]:=X(xs[(j*2)%4]); v:=dup(u); w:=u*2; }
		with { s:=1; } do { y:=move(v); }
	}
	w+=dup(j);
	return xs;
}
def movedInBranchWith(xs:𝔹^4,const c:!𝔹,const j:!ℕ)mfree{
	v:=dup(j);
	w:=v*2;
	if c {
		y:=move(w);
	} else {
		with { u:=dup(j); } do {
			t:=move(v);
			xs[(w+1)%4]:=X(xs[(w+1)%4]);
			v:=1;
		}
		forget(t);
	}
	return xs;
}
