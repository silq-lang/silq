// args: --remove-loops --run

def foo(const a:𝔹,const b:𝔹){
	c:=dup(a);
	e:=dup(b);
	d:=0:𝔹;
	for i in [0..3){
		if i%2==0 {
			e⊕=c;
			forget(e);
			e:=dup(b);
		}
		c⊕=e;
		if c { d:=H(d); }
	}
	a2:=H(dup(a));
	r:=dup(e);
	measure(a2);
	return (d,c,r);
}
def main(){
	a:=H(0:𝔹);
	b:=H(0:𝔹);
	r:=foo(a,b);
	return (a,b,r);
}
