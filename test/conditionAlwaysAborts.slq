// args: --compile
// A condition whose type is ⊥, such as an index known to be out of bounds,
// crashed the HQIR generator, which expected a boolean. It always aborts, so
// neither branch runs, and the if is typed ⊥: as an expression, the variables
// its branches consume were otherwise left over after it.
// (Found by fuzzing.)
def f(){
	a:=vector(3,1:𝔹);
	if a[127]&a[2]{ a[1]:=X(a[1]); }
	return a;
}
def g(){
	a:=vector(3,1:!𝔹);
	x:=if a[127] then 1 else 2;
	while a[127]{}
	return x;
}
def h(){
	a:=(0,1):!𝔹^2;
	q:=H(0:𝔹);
	r:=if a[5] then H(q) else q;
	return r;
}
