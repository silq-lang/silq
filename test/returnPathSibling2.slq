def h(x:𝔹){ return measure(x); }

def consumedBeforePartialReturn(a:𝔹,k:!𝔹,l:!𝔹,j:!𝔹){
	v0:=dup(a);
	v1:=!v0; /// error
	t1:=h(v1);
	if k { t2:=h(v0); a:=X(a); if l { return (a,t1,t2); } }
	if j { x5:=(a,true); t6:=measure(v1); assert(false); }
	t7:=measure(v1);
	return (a,t1,t7);
}

def consumedAfterReturn(a:𝔹,k:!𝔹,j:!𝔹){
	v0:=dup(a);
	v1:=!v0;
	t1:=h(v1);
	if k { t2:=h(v0); x3:=(a,true); return (x3,t1,t2); }
	t4:=h(v0);
	a:=X(a);
	t7:=measure(v1); /// error
	return (a,t1,t7);
}
