// args: --run

def recomputed(){
	k:=0;
	do{ k+=1; n:=k+1; v:=vector(n,0:𝔹); }while k<2 { measure(v); }
	return (n,measure(v): !𝔹[]);
}
def returned(){
	k:=0;
	do{ k+=1; n:=k+1; v:=vector(n,1:𝔹); v[0]:=H(v[0]); v[0]:=H(v[0]); }while k<2 { measure(v); }
	return (n,measure(v): !𝔹[]);
}
def mixed(){
	k:=0;
	do{ k+=1; n:=k+1; a:=vector(n,true); q:=vector(n,0:𝔹); q[0]:=H(q[0]); q[0]:=H(q[0]); }while k<2 { measure(q); }
	return (n,a: !𝔹[],measure(q): !𝔹[]);
}
def branches(b:!𝔹){
	k:=0;
	do{ k+=1; m:=k+1; v:=vector(m,0:𝔹); }while k<2;
	if b { forget(v=vector(m,0:𝔹)); repeat 2 {} } else { measure(v); }
	return k;
}
def changed(){
	c:=0;
	k:=0;
	do{ k+=1; c+=1; v:=vector(c,1:𝔹); v[0]:=X(v[0]); }while k<2 { measure(v); }
	return (c,measure(v): !𝔹[]);
}
def main(){
	r:=(recomputed(),returned(),mixed(),branches(true),branches(false),changed());
	assert(r==((3,[0,0,0]),(3,[1,1,1]),(3,[1,1,1],[0,0,0]),2,2,(2,[0,1])));
	return r;
}
