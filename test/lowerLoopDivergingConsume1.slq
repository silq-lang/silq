// args: --run

def f(m:!ℕ){
	x:=vector(m,1:!𝔹);
	k:=0;
	do{
		k+=1;
		j:=0;
		do{ j+=1; m+=1; x:=vector(1,1:!𝔹); }while j<1 { return 0; }
	}while k<1 { repeat 1 { return 1; } }
	return m+x.length;
}

def g(m:!ℕ){
	x:=vector(m,0:𝔹);
	k:=0;
	while k<1 {
		k+=1;
		j:=0;
		do{ j+=1; measure(x); m+=2; x:=vector(m,0:𝔹); }while j<1 { return (0,[]:!𝔹[]); }
		repeat 2 { return (m,measure(x:𝔹[])); }
	}
	return (1,[]:!𝔹[]);
}

def main(){
	assert(f(2)==4);
	assert(g(1)==(3,[0,0,0]));
}
