	q[3]:=H(q[3]); q[3]:=H(q[3]);
	q[0]:=H(q[0]); q[0]:=H(q[0]);
	q[3]:=X(q[3]);
	q[4]:=H(q[4]); q[4]:=H(q[4]);
	q[0]:=X(q[0]);
	q[1]:=X(q[1]);
