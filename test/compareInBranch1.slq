// args: --run

def paramLength(n:!ℕ,c:!𝔹){
	if c { r:=vector(n,0:!𝔹)==vector(n,0:!𝔹); } else { r:=false; }
	return r;
}
def changedAfter(k:!ℕ,c:!𝔹){
	m:=dup(k);
	if c { r:=vector(m,0:!𝔹)==vector(m,1:!𝔹); m+=1; } else { r:=true; }
	return (r,m);
}
def conditional(n:!ℕ){
	return if n>1 then vector(n,0:!𝔹)==vector(n,0:!𝔹) else vector(n,1:!𝔹)≠vector(n,0:!𝔹);
}
def lexicographic(n:!ℕ,c:!𝔹){
	if c { r:=vector(n,1:!ℕ)<vector(n,2:!ℕ); } else { r:=false; }
	return r;
}
def typeVariable(n:!ℕ,c:!𝔹){
	t:=!𝔹^n;
	x:=vector(n,0:!𝔹):t;
	y:=vector(n,0:!𝔹):t;
	if c { r:=x==y; } else { r:=false; }
	return r;
}
def main(){
	r:=(paramLength(2,true),changedAfter(2,true),conditional(3),conditional(1),lexicographic(2,true),typeVariable(2,true));
	assert(r==(1,(0,3),1,1,1,1));
	return r;
}
