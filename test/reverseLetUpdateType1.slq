// args: --run

def consumed(x:𝔹,const n:!ℕ,const c:!ℕ)qfree{
	k:=dup(n);
	y:=let { if k>0 { a:=(dup(n),k+c):!ℕ^2; if a[1]==2 { x:=X(x); } } if c==1 { if n==1 { k+=1; } x:=X(x); } } in x;
	return y;
}
def returned(x:𝔹,const n:!ℕ,const c:!ℕ)qfree{
	k:=dup(n);
	if k>0 { a:=(dup(n),k+c):!ℕ^2; if a[1]==2 { x:=X(x); } }
	(y,k):=let { if c==1 { k+=1; } z:=X(x); } in (z,k);
	return (y,k);
}
def multiplied(x:𝔹,const n:!ℕ,const c:!ℕ)qfree{
	k:=dup(n);
	y:=let { if k>0 { a:=(dup(n),k+1):!ℕ^2; if a[1]==3 { x:=X(x); } } if c==1 { if n>0 { k*=2; } x:=X(x); } } in x;
	return y;
}
def main(){
	r:=(measure(reverse(consumed)(0:𝔹,1,1)),measure(reverse(consumed)(0:𝔹,1,0)),measure(reverse(returned)((0:𝔹,2),1,1)),measure(reverse(returned)((0:𝔹,1),1,0)),measure(reverse(multiplied)(0:𝔹,2,1)),measure(reverse(multiplied)(0:𝔹,1,1)));
	assert(r==(0,0,0,1,0,1));
	return r;
}
